generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// TAFSIR DATA MODELS
// ----------------------------------------------------

model Language {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. 'en', 'ar', 'ur'
  name      String   // e.g. 'English', 'Arabic', 'Urdu'
  
  authors   Author[]
}

model Author {
  id         Int        @id @default(autoincrement())
  name       String     // e.g. 'Tafsir Ibn Kathir'
  authorName String?    // e.g. 'Hafiz Ibn Kathir'
  languageId Int
  language   Language   @relation(fields: [languageId], references: [id])
  era        String?    // e.g. 'Early Classical (7th-10th CE)'
  tags       Tag[]      // Methodology tags
  
  tafsirs    TafsirEntry[]
}

model Tag {
  id      Int      @id @default(autoincrement())
  name    String   @unique // e.g. 'Athari / Riwayah', 'Linguistic', 'Sufi / Ishari', 'Modern'
  color   String?  // e.g. 'emerald', 'blue', 'amber', 'purple'
  authors Author[]
}

model Surah {
  id          Int      @id // 1 to 114
  name        String   // Arabic name
  englishName String   // Transliterated name
  
  ayahs       Ayah[]
  tafsirs     TafsirEntry[]
}

model Ayah {
  id            Int      @id @default(autoincrement())
  surahId       Int
  surah         Surah    @relation(fields: [surahId], references: [id])
  numberInSurah Int      // e.g. 1 to 286 (for Al-Baqarah)
  text          String   // Arabic text
  
  tafsirs       TafsirEntry[]
  lexiconWords  LexiconWord[]
  
  @@unique([surahId, numberInSurah])
}

model TafsirEntry {
  id       Int    @id @default(autoincrement())
  authorId Int
  author   Author @relation(fields: [authorId], references: [id])
  surahId  Int
  surah    Surah  @relation(fields: [surahId], references: [id])
  ayahId   Int
  ayah     Ayah   @relation(fields: [ayahId], references: [id])
  
  text     String // The actual tafsir text content
  
  @@index([authorId, surahId, ayahId])
}

// ----------------------------------------------------
// LEXICON & MORPHOLOGY DATA MODELS
// ----------------------------------------------------

model LexiconWord {
  id          Int     @id @default(autoincrement())
  ayahId      Int
  ayah        Ayah    @relation(fields: [ayahId], references: [id])
  wordNumber  Int     // Position of word in ayah
  wordArabic  String  // e.g. 'الْحَمْدُ'
  rootWord    String? // e.g. 'ح م د'
  lemma       String?
  
  lexiconEntries LexiconEntry[]
}

model LexiconBook {
  id      Int    @id @default(autoincrement())
  name    String // e.g. 'Lane Lexicon'
  author  String
  
  entries LexiconEntry[]
}

model LexiconEntry {
  id            Int         @id @default(autoincrement())
  lexiconWordId Int
  lexiconWord   LexiconWord @relation(fields: [lexiconWordId], references: [id])
  lexiconBookId Int
  lexiconBook   LexiconBook @relation(fields: [lexiconBookId], references: [id])
  
  text          String      // The lexicon definition
}

// ----------------------------------------------------
// AI RATE LIMITING & QUOTA TRACKING
// ----------------------------------------------------

model UserUsage {
  id                  Int      @id @default(autoincrement())
  identifier          String   @unique // e.g. IP Address or User ID
  dailyTokensConsumed Int      @default(0)
  lastResetDate       DateTime @default(now())

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ModelUsage {
  id                   Int      @id @default(autoincrement())
  modelName            String   @unique // e.g. 'gemini-3.1-flash-lite'
  
  // Rolling RPM Bucket
  rpmCount             Int      @default(0)
  rpmLastReset         DateTime @default(now())
  
  // Weekly Budget Bucket
  weeklyTokensConsumed Int      @default(0)
  weeklyLastReset      DateTime @default(now())

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ----------------------------------------------------
// SUBSCRIPTIONS & USER TIERS
// ----------------------------------------------------

model User {
  id            String        @id @default(cuid())
  email         String?       @unique
  name          String?
  tier          String        @default("FREE") // "FREE", "PRO", "PATRON"
  subscription  Subscription?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lemonSqueezyId       String?   @unique
  customerId           String?
  variantId            String?
  status               String    @default("active") // "active", "cancelled", "past_due"
  plan                 String    @default("PRO_MONTHLY")
  renewsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ----------------------------------------------------
// NOTES & HIGHLIGHTS
// ----------------------------------------------------

model UserNote {
  id          String   @id @default(cuid())
  identifier  String   // e.g. local UUID or email to map to the user device
  surahId     Int
  ayahNumber  Int
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([identifier])
}

model UserHighlight {
  id          String   @id @default(cuid())
  identifier  String
  surahId     Int
  ayahNumber  Int
  text        String
  type        String   @default("arabic") // "arabic" or "translation"
  authorName  String?  // The name of the tafsir author if highlighted from a tafsir
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([identifier])
}
