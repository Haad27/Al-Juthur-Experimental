    "ayah": 9,
    "text": ""
  },
  {
    "surah": 44,
    "ayah": 10,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَارْتَقِبْ يَوْمَ تَأْتِي السَّمَآءُ بِدُخَانٍ مُّبِينٍ﴾</span> معناه فانتظرْ يومَ تأتي السَّماءُ بِدُخانٍ مُّبينٍ."
  },
  {
    "surah": 44,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 44,
    "ayah": 12,
    "text": ""
  },
