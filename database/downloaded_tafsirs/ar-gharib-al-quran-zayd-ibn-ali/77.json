[
  {
    "surah": 77,
    "ayah": 1,
    "text": "أخبرنا أبو جعفر. قال : حدّثنا علي بن أحمد. قال : حدّثنا عطاءُ بن السّائب عن أبي خالد عن زيد بن علي عليهما السّلامُ في قولهِ تعالى :<span class=\"book-ayah text-primary\">﴿وَالْمُرْسَلاَتِ عُرْفاً﴾</span> معناه الرِّيحُ تُرسلُ بالمعروفِ. ويقالُ : هي المَلائكةُ. ويقالُ : عُرفٌ تَتبعُ بعضَها بَعضاً."
  },
  {
    "surah": 77,
    "ayah": 2,
    "text": "<span class=\"book-ayah text-primary\">﴿فَالْعَاصِفَاتِ عَصْفاً﴾</span> معناه الرِّيحُ"
  },
  {
    "surah": 77,
    "ayah": 3,
    "text": "<span class=\"book-ayah text-primary\">﴿والنَّاشِرَاتِ نَشْراً﴾</span> معناه الرّيحُ. ويقال : المُمطرُ. ويقال : البَعثُ يوم القِيامةِ."
  },
  {
    "surah": 77,
    "ayah": 4,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَالْفَارِقَاتِ فَرْقاً﴾</span> معناه الرّسلُ."
  },
  {
    "surah": 77,
    "ayah": 5,
    "text": "<span class=\"book-ayah text-primary\">﴿فَالْمُلْقِيَاتِ ذِكْراً﴾</span> يعني الملائكة والذِّكرُ : القرآنُ."
  },
  {
    "surah": 77,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿عُذْراً أَوْ نُذْراً﴾</span> معناه عُذرٌ من الله تعالى ونُذرٌ إلى النَّاسِ."
  },
  {
    "surah": 77,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 77,
    "ayah": 8,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَإِذَا النُّجُومُ طُمِسَتْ﴾</span> يعني ذَهبَ ضَوءُها."
  },
  {
    "surah": 77,
    "ayah": 9,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَإِذَا السَّمَآءُ فُرِجَتْ﴾</span> معناه كُشِفتْ."
