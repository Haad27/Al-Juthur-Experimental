  {
    "surah": 29,
    "ayah": 12,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿اتَّبِعُواْ سَبِيلَنَا﴾</span> معناه دِيننا."
  },
  {
    "surah": 29,
    "ayah": 13,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَلَيَحْمِلُنَّ أَثْقَالَهُمْ﴾</span> معناه أوزارُهم."
  },
  {
    "surah": 29,
    "ayah": 14,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَأَخَذَهُمُ الطُّوفَانُ﴾</span> معناه الموتُ الفَاشي"
  },
