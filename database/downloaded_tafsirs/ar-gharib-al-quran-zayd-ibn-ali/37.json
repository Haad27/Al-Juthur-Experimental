  },
  {
    "surah": 37,
    "ayah": 101,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 102,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ﴾</span> معناه أطاقَ العَملَ."
  },
  {
    "surah": 37,
    "ayah": 103,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَلَمَّا أَسْلَمَا وَتَلَّهُ لِلْجَبِينِ﴾</span> معناه صَرعهُ. فالجبينُ ها هنا الجَبهةُ عن يمينٍ وشِمالٍ. وأسلما : معناه اتفق أَمرُهما."
  },
  {
    "surah": 37,
    "ayah": 104,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 105,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 106,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 107,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ﴾</span> فالذَّبحُ : المَذبُوحُ. والذَّبحُ : الفِعلُ. والعَظيمُ : المُتقبلُ."
  },
  {
    "surah": 37,
    "ayah": 108,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَتَرَكْنَا عَلَيْهِ فِي الآخِرِينَ﴾</span> معناه الثَّناءُ الحَسنُ."
  },
