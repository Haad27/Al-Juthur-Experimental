  },
  {
    "surah": 37,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 18,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَأَنتُمْ دَاخِرُونَ﴾</span> معناه صَاغرُونَ أَذلاء."
  },
  {
    "surah": 37,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 20,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿هَذَا يَوْمُ الدِّينِ﴾</span> معناه يَومُ الجَزاءِ."
  },
  {
    "surah": 37,
    "ayah": 21,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿هَذَا يَوْمُ الْفَصْلِ﴾</span> معناه يَومُ قَطعِ القَضاءِ."
  },
  {
    "surah": 37,
    "ayah": 22,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿احْشُرُواْ الَّذِينَ ظَلَمُواْ وَأَزْوَاجَهُمْ﴾</span> معناه وأمثالُهُمْ وأَشباهُهُم وضُرباؤهُمْ."
  },
  {
    "surah": 37,
    "ayah": 23,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَاهْدُوهُمْ﴾</span> معناه دلُّوهُم."
  },
  {
    "surah": 37,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 26,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ﴾</span> معناه يُعْطُونَ بأيدِيهِم."
  },
