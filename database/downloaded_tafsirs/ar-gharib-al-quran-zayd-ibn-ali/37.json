  {
    "surah": 37,
    "ayah": 45,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿بِكَأْسٍ مِّن مَّعِينٍ﴾</span> فالكأسُ : الإِناءُ بما فيها من الخَمرِ."
  },
  {
    "surah": 37,
    "ayah": 46,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 47,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿لاَ فِيهَا غَوْلٌ﴾</span> معناه أَذى وذهابُ عَقلٍ. وقال : وجعُ البَطنِ <span class=\"book-ayah text-primary\">﴿وَلاَ هُمْ عَنْهَا يُنزَفُونَ﴾</span> معناه لا ينقطعُ ذلك عنهم، ولا تَنْزِفُ عُقُولُهُم."
  },
  {
    "surah": 37,
    "ayah": 48,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿قَاصِرَاتُ الطَّرْفِ [ عِينٌ ]﴾</span> معناه راضياتٌ بأزواجهنَّ لا تطمحُ عُيونُهُنّ إلى غَيرِهم. والعِينُ : الواسعاتُ العَينِ، واحدها عيناءٌ."
  },
  {
    "surah": 37,
    "ayah": 49,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿بَيْضٌ مَّكْنُونٌ﴾</span> معناه مَصونٌ."
  },
  {
    "surah": 37,
    "ayah": 50,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 51,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿قَالَ قَآئِلٌ مِّنْهُمْ إِنِّي كَانَ لِي قَرِينٌ﴾</span> معناه صاحبٌ."
  },
  {
    "surah": 37,
    "ayah": 52,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 53,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿أإنا لَمَدِينُونَ﴾</span> معناه لَمَجزِيونَ."
  },
  {
    "surah": 37,
    "ayah": 54,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 55,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فِي سَوَآءِ الْجَحِيمِ﴾</span> معناه وسطُ الجَحيمِ."
  },
  {
    "surah": 37,
    "ayah": 56,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿تَاللَّهِ إِن كِدتَّ لَتُرْدِينِ﴾</span> معناه تَهْلِكُني."
  },
