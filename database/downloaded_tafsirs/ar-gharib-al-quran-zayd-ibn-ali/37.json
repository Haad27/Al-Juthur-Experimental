[
  {
    "surah": 37,
    "ayah": 1,
    "text": "أخبرنا أبو جعفر. قال : حدّثنا علي بن أحمد. قال : حدّثنا عطاء بن السائب عن أبي خالد الواسطي عن زيد بن علي عليهما السَّلامُ في قولهِ تعالى :<span class=\"book-ayah text-primary\">﴿وَالصَّافَّاتِ صَفَّا﴾</span> أي الملائكة"
  },
  {
    "surah": 37,
    "ayah": 2,
    "text": "<span class=\"book-ayah text-primary\">﴿فَالزَّاجِرَاتِ زَجْراً﴾</span> أي الملائكة."
  },
  {
    "surah": 37,
    "ayah": 3,
    "text": "<span class=\"book-ayah text-primary\">﴿فَالتَّالِيَاتِ ذِكْراً﴾</span> أي الملائكة. والتالي : القَارئ."
  },
  {
    "surah": 37,
    "ayah": 4,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 5,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 7,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَحِفْظاً مِّن كُلِّ شَيْطَانٍ مَّارِدٍ﴾</span> معناه متمردٌ عاتٍ."
  },
  {
    "surah": 37,
    "ayah": 8,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿لاَّ يَسَّمَّعُونَ﴾</span> معناه يَتَسمَّعون ولا يَسمَعون. <br />\nوقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ دُحُوراً﴾</span> معناه يُرمون من كُلِّ جَانبٍ."
  },
  {
    "surah": 37,
    "ayah": 9,
    "text": "دُحوراً. أي إبعاداً. وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَلَهُمْ عَذابٌ وَاصِبٌ﴾</span> معناه دائمٌ."
  },
  {
    "surah": 37,
    "ayah": 10,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿إِلاَّ مَنْ خَطِفَ الْخَطْفَةَ﴾</span> معناه استلَبَ <span class=\"book-ayah text-primary\">﴿فَأَتْبَعَهُ شِهَابٌ ثَاقِبٌ﴾</span> معناه مُضيءٌ بَيّنٌ."
  },
  {
    "surah": 37,
    "ayah": 11,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَاسْتَفْتِهِمْ﴾</span> معناه فسَلْهُمْ. <br />\nوقوله تعالى :<span class=\"book-ayah text-primary\">﴿مِّن طِينٍ لاَّزِبٍ﴾</span> معناه لاَزمٌ لاَزقٌ. واللازبُ من الطينِ اللزجُ. ويقال : الجَيدُ."
  },
  {
    "surah": 37,
    "ayah": 12,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿بَلْ عَجِبْتَ﴾</span> معناه استعظمتَ."
  },
  {
    "surah": 37,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 14,
    "text": ""
