  },
  {
    "surah": 37,
    "ayah": 65,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿طَلْعُهَا كَأَنَّهُ رُءُوسُ الشَّيَاطِينِ﴾</span> وهو نبتٌ قَبيحُ المَنظرِ."
  },
  {
    "surah": 37,
    "ayah": 66,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 67,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباً مِنْ حَمِيمٍ﴾</span> فالشَّوبُ : الخَلطُ بينَ الشَّيئينِ."
  },
  {
    "surah": 37,
    "ayah": 68,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 69,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿إِنَّهُمْ أَلْفَوْاْ آبَآءَهُمْ ضَآلِّينَ﴾</span> معناه وَجَدُوا."
  },
  {
    "surah": 37,
    "ayah": 70,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿عَلَى آثَارِهِمْ يُهْرَعُونَ﴾</span> معناه يَستَحَثْون، ويُسرعُ بهم."
  },
