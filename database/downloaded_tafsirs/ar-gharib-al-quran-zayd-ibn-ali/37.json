  },
  {
    "surah": 37,
    "ayah": 140,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَإِنَّ يُونُسَ لَمِنَ الْمُرْسَلِينَ إِذْ أَبَقَ إِلَى الْفُلْكِ الْمَشْحُونِ فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضِينَ﴾</span> فأَبَقَ : قَرَع. والفُلْك : السَّفينةُ والمَشحونُ : المملوءُ المُوقرُ."
  },
  {
    "surah": 37,
    "ayah": 141,
    "text": "فَساهمَ فكانَ مِنَ المُدْحَضِين : أَي قَارَعَ والمُدحضُ : المُبْطلُ الحُجةُ."
  },
  {
    "surah": 37,
    "ayah": 142,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُلِيمٌ﴾</span> معناه أتى أمراً يُلامُ عليه. وقال التَقمهُ الحُوتُ غدوةً ولَفَظهُ عَشيةً ويقال : لَبِثَ فِي بَطنهِ سَبعةَ أيامٍ. ويقالُ : أربعُون يوماً."
  },
  {
    "surah": 37,
    "ayah": 143,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَلَوْلاَ أَنَّهُ كَانَ مِنَ الْمُسَبِّحِينَ﴾</span> معناه من المُصلين."
  },
  {
    "surah": 37,
    "ayah": 144,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 145,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَنَبَذْنَاهُ بِالْعَرَآءِ﴾</span> معناه بالفَضاءِ من الأَرضِ."
  },
  {
    "surah": 37,
    "ayah": 146,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿وَأَنبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ﴾</span> : معناه من قَرْعٍ، وقال : إنَّ اليَقطينَ كُلُّ شَجرةٍ لاَ تَقومُ عَلَى سَاقٍ."
  },
  {
    "surah": 37,
    "ayah": 147,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿وَأَرْسَلْنَاهُ إِلَى مِئَةِ أَلْفٍ أَوْ يَزِيدُونَ﴾</span> معناه ويَزيدون."
  },
