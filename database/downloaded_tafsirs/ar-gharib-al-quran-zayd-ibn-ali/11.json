    "ayah": 72,
    "text": ""
  },
  {
    "surah": 11,
    "ayah": 73,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿رَحْمَتُ اللَّهِ وَبَرَكَاتُهُ عَلَيْكُمْ أَهْلَ الْبَيْتِ﴾</span> فالبَركاتُ : هي السَّعادةُ."
  },
  {
    "surah": 11,
    "ayah": 74,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَلَمَّا ذَهَبَ عَنْ إِبْرَاهِيمَ الرَّوْعُ﴾</span> معناه الخَوفُ والفَزعُ."
  },
  {
    "surah": 11,
    "ayah": 75,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿مُّنِيبٌ﴾</span> معناه تائبٌ."
  },
  {
    "surah": 11,
    "ayah": 76,
    "text": ""
  },
  {
    "surah": 11,
    "ayah": 77,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿يَوْمٌ عَصِيبٌ﴾</span> معناهُ شديدٌ."
  },
  {
    "surah": 11,
    "ayah": 78,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿يُهْرَعُونَ إِلَيْهِ﴾</span> معناهُ يُسْتَحثُّونَ، ويُسرَعُ بِهم."
  },
  {
    "surah": 11,
    "ayah": 79,
    "text": ""
  },
  {
    "surah": 11,
    "ayah": 80,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿أَوْ آوِي إِلَى رُكْنٍ شَدِيدٍ﴾</span> معناهُ أصير فاُنصرْ. والرُّكنُ الشَّدِيدُ : العَشِيرةُ. والشَّديدُ : العَزيزُ المَنِيعُ."
  },
  {
    "surah": 11,
    "ayah": 81,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿فَأَسْرِ بِأَهْلِكَ﴾</span> معناهُ سِرْ. يقالُ : للسَّيرِ بالليلِ السُّرى. يقالُ : سَريتُ وأسْريتُ. وبالنَّهارِ سِرتُ."
  },
  {
    "surah": 11,
    "ayah": 82,
    "text": "وقوله تعالى :<span class=\"book-ayah text-primary\">﴿حِجَارَةً مِّن سِجِّيلٍ﴾</span> معناه شَديدٌ صَلِبٌ. ويقال إِنَّها بالفَارسيةِ سك وكل، وماءٌ وَطينٌ."
  },
  {
    "surah": 11,
    "ayah": 83,
    "text": ""
  },
