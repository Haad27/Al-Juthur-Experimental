    "surah": 55,
    "ayah": 19,
    "text": "• <span class=\"book-ayah text-primary\">﴿مَرَجَ﴾</span> المَرْجُ: الإرسالُ كقوله: مَرَجَ الدَّابَّةَ أَرْسَلَهَا تَرْعَى، والمعنى أَرْسَلَ البَحْرَيْنِ."
  },
  {
    "surah": 55,
    "ayah": 20,
    "text": "• <span class=\"book-ayah text-primary\">﴿بَرْزَخٌ﴾</span> حَاجِزٌ."
