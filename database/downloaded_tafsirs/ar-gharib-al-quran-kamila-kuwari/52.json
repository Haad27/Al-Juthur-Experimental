  {
    "surah": 52,
    "ayah": 1,
    "text": "• <span class=\"book-ayah text-primary\">﴿وَالطُّورِ﴾</span> الجَبَلُ الَّذِي كَلَّمَ اللهُ عَلَيْهِ مُوسَى عَلَيْهِ السَّلَامُ."
  },
  {
    "surah": 52,
    "ayah": 2,
    "text": "• <span class=\"book-ayah text-primary\">﴿مَسْطُورٍ﴾</span> مَكْتُوبٌ، أما اللوحُ المحفوظُ، أو القرآنُ يَكْتُبُهُ المؤمنون في المصاحفِ."
  },
  {
    "surah": 52,
    "ayah": 3,
    "text": "• <span class=\"book-ayah text-primary\">﴿رَقٍّ مَّنشُورٍ﴾</span> مَبْسُوطٌ وَمَفْتُوحٌ، والرَّقُّ: ما يُكْتَبُ فيه، وهو جِلْدٌ رَقِيقٌ، وَكُلّ صَحِيفَةٍ فهي رَقٌّ لِرِقَّةِ حَوَاشِيهَا."
  },
  {
    "surah": 52,
    "ayah": 4,
    "text": "• <span class=\"book-ayah text-primary\">﴿المَعْمُورِ﴾</span> تَعْمُرُهُ الملائكةُ وَيُعْبَدُ اللهُ فيه وهو البيتُ الَّذِي فَوْقَ السماءِ السابعةِ، مَعْمُورٌ مَدَى الأَوْقَاتِ، وقيل: بيتُ اللهِ الحرامِ الَّذِي يَأْتُونَ إليه في الحجِّ والعُمْرَةِ."
  },
  {
    "surah": 52,
    "ayah": 5,
    "text": "• <span class=\"book-ayah text-primary\">﴿وَالسَّقْفِ المَرْفُوعِ﴾</span> السَّمَاءُ."
  },
