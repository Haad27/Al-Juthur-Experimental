    "surah": 37,
    "ayah": 144,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 145,
    "text": "• <span class=\"book-ayah text-primary\">﴿بِالْعَرَاء﴾</span> العَرَاءُ: المكانُ الخالي من الشَّجَرِ كأنَّ اشْتِقَاقَهُ من العُرْيِ."
  },
  {
    "surah": 37,
    "ayah": 146,
    "text": "• <span class=\"book-ayah text-primary\">﴿يَقْطِينٍ﴾</span> القرعُ عِنْدَ الأَكْثَرِ."
