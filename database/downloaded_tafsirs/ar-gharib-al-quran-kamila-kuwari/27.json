  {
    "surah": 27,
    "ayah": 23,
    "text": "• <span class=\"book-ayah text-primary\">﴿لَهَا عَرْشٌ عَظِيمٌ﴾</span> سَرِيرٌ كَبِيرٌ."
  },
  {
    "surah": 27,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 27,
    "ayah": 25,
    "text": "• <span class=\"book-ayah text-primary\">﴿الخَبْءَ﴾</span> الخَفِيَّ المَخْبُوءَ."
  },
  {
    "surah": 27,
    "ayah": 26,
    "text": "• <span class=\"book-ayah text-primary\">﴿رَبُّ الْعَرْشِ الْعَظِيمِ﴾</span> الَّذِي هُوَ سَقْفُ المخلوقاتِ، وَوَسِعَ الأَرْضَ وَالسَّماواتِ."
  },
