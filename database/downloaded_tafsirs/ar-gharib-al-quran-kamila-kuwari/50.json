  {
    "surah": 50,
    "ayah": 18,
    "text": "• <span class=\"book-ayah text-primary\">﴿عَتِيدٌ﴾</span> حَاضِرٌ لا يَغِيبُ."
  },
  {
    "surah": 50,
    "ayah": 19,
    "text": "• <span class=\"book-ayah text-primary\">﴿تَحِيدُ﴾</span> ذلك الموتُ الَّذِي كُنْتَ تَفِرُّ مِنْهُ."
  },
  {
    "surah": 50,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 50,
    "ayah": 21,
    "text": "• <span class=\"book-ayah text-primary\">﴿سَائِقٌ وَشَهِيدٌ﴾</span> السائقُ: مَلَكٌ يَسُوقُ إلى المَحْشَرِ، وَالشَّهِيدُ: مَلَكٌ يَشْهَدُ بالعَمَلِ، وقيل: هذا في الكَافِرِ."
  },
  {
    "surah": 50,
    "ayah": 22,
    "text": "• <span class=\"book-ayah text-primary\">﴿غِطَاءكَ﴾</span> رَفَعْنَا عَنْكَ الحِجَابَ الَّذِي كان بَيْنَكَ وَبَيْنَ أُمُورِ الآخِرَةِ، وقيل: كُشِفَ الغِطَاءُ، وَبَانَ الخَفِيُّ وَاتَّضَحَ كُلّ شَيْءٍ."
  },
  {
    "surah": 50,
    "ayah": 23,
    "text": "• <span class=\"book-ayah text-primary\">﴿قَرِينُهُ﴾</span> مَلَكُهُ المُوَكَّلُ بِحِفْظِ أَعْمَالِهِ، فَكُلُّ إنسانٍ له مَلَكٌ عَنِ اليَمِينِ وَعَنِ الشِّمَالِ قَعِيدٌ، <span class=\"book-ayah text-primary\">﴿عَتِيدٌ﴾</span> حَاضِرٌ."
  },
