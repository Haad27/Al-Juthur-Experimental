  },
  {
    "surah": 20,
    "ayah": 16,
    "text": "• <span class=\"book-ayah text-primary\">﴿فَتَرْدَى﴾</span> فَتَهْلِكُ."
  },
  {
    "surah": 20,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 18,
    "text": "• <span class=\"book-ayah text-primary\">﴿وَأَهُشُّ بِهَا عَلَى غَنَمِي﴾</span> أضربُ بها الشجرَ لِيَتَسَاقَطَ الورقُ عَلَى غنمي فتأكلُ منه، ويحتمل أن يكون المرادُ: أَسُوقُ بها غَنَمِي."
  },
  {
    "surah": 20,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 22,
    "text": "• <span class=\"book-ayah text-primary\">﴿وَاضْمُمْ يَدَكَ إِلَى جَنَاحِكَ﴾</span> أَصْلُ الجناحِ للطائرِ ثم أُطْلِقَ عَلَى اليدِ والعَضُدِ والجَنْبِ وهو المرادُ هنا، وقيل: أَصْلُ الجناحِ من الجُنُوحِ وهو الميلُ؛ لأن الطائرَ يَمِيلُ به في طَيَرَانِه، وَعَضُدُ الإنسانِ جناحُه؛ لأن مِنْ جهتِه يُمِيلُ اليدَ حيث شاء صاحبُها، فالمعنى: اجْعَلْ يَدَكَ إلى جَنْبِكَ تَحْتَ عَضُدِكَ، وَجَنَاحَا الإنسانِ: جَنْبَاهُ."
  },
  {
    "surah": 20,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 26,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 27,
    "text": "• <span class=\"book-ayah text-primary\">﴿عُقْدَةً﴾</span> حُبْسَةً كَغُرْفَةٍ، والعقدةُ: مَوْضِعُ رَبْطِ بعضِ الخيطِ أو الخيطِ ببعضٍ آخَرَ، وأُطْلِقَتْ عَلَى عُسْرِ النطقِ بالكلامِ، أو ببعضِ الحروفِ، ويقال: حُبْسَةٌ، فَشَبَّهَ مُوسَى حُبْسَةَ لِسَانِهِ بالعُقْدَةِ في الحَبْلِ ونَحْوِهِ."
  },
  {
    "surah": 20,
    "ayah": 28,
    "text": "• <span class=\"book-ayah text-primary\">﴿يَفْقَهُوا قَوْلِي﴾</span> أي: يَفْهَمُوا قولي، وهو فِعْلٌ مُضَارِعٌ مَجْزُومٌ؛ لأنه جوابُ الدعاءِ أي الطلب، وعلامةُ جَزْمِهِ حذفُ النونِ."
  },
  {
    "surah": 20,
    "ayah": 29,
    "text": ""
  },
