  {
    "surah": 20,
    "ayah": 94,
    "text": "• <span class=\"book-ayah text-primary\">﴿تَرْقُبْ﴾</span> أي: لم تَحْفَظْ قَوْلِي لَكَ: <span class=\"book-ayah text-primary\">﴿اخْلُفْنِي فِي قَوْمِي وَأَصْلِحْ﴾</span>، والرقيبُ: الحافظُ."
  },
  {
    "surah": 20,
    "ayah": 95,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 96,
    "text": "• <span class=\"book-ayah text-primary\">﴿مِنْ أَثَرِ الرَّسُولِ﴾</span> مِنْ أَثَرِ حَافِرِ فَرَسِ الرَّسُولِ جِبْرِيلَ."
  },
  {
    "surah": 20,
    "ayah": 97,
    "text": "• <span class=\"book-ayah text-primary\">﴿لَا مِسَاسَ﴾</span> لا يَمَسَّنِي أَحَدٌ، فَعُقُوبَتُكَ أنه لا يَقْتَرِبُ مِنْكَ أَحَدٌ."
  },
  {
    "surah": 20,
    "ayah": 98,
    "text": ""
