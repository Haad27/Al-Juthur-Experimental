  {
    "surah": 44,
    "ayah": 14,
    "text": "• <span class=\"book-ayah text-primary\">﴿مُعَلَّمٌ﴾</span> يُعَلِّمُهُ بَشَرٌ.<br />\r• <span class=\"book-ayah text-primary\">﴿مَجْنُونٌ﴾</span> أَصَابَهُ مَسٌّ مِنَ الجِنِّ وليسَ بِرَسُولٍ."
  },
  {
    "surah": 44,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 44,
    "ayah": 16,
    "text": "• <span class=\"book-ayah text-primary\">﴿الْبَطْشَةَ﴾</span> يَوْمَ القِيَامَةِ، وقيل: يَوْمَ بَدْرٍ."
  },
  {
    "surah": 44,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 44,
    "ayah": 18,
    "text": "• <span class=\"book-ayah text-primary\">﴿أَنْ أَدُّوا﴾</span> مَا هُوَ وَاجِبٌ عَلَيْكُمْ."
  },
  {
    "surah": 44,
    "ayah": 19,
    "text": "• <span class=\"book-ayah text-primary\">﴿وَأَنْ لّا تَعْلُوا عَلَى اللهِ﴾</span> بِالِاسْتِكْبَارِ عَنْ عِبَادَتِهِ والعُلُوِّ عَلَى عِبَادِ اللهِ."
  },
