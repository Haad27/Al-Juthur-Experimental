  {
    "surah": 40,
    "ayah": 18,
    "text": "• <span class=\"book-ayah text-primary\">﴿الْآزِفَةِ﴾</span> القريبةُ، وَهِيَ القِيَامَةُ."
  },
  {
    "surah": 40,
    "ayah": 19,
    "text": "• <span class=\"book-ayah text-primary\">﴿خَائِنَةَ الْأَعْيُنِ﴾</span> خِيَانَتهَا وَمُسَارَقَتهَا، أي: النظرَ إلى ما يَحِلُّ، وهو النظرُ الَّذِي يُخْفِيهِ العبدُ عن جَلِيسِهِ."
  },
