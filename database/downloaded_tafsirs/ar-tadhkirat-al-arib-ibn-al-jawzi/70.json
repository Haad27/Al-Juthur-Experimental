[
  {
    "surah": 70,
    "ayah": 1,
    "text": "السائل النضر بن الحارث حين قال فأمطر علينا حجارة ومن قرأ سال ففيه وجهان أحدهما أنه من السؤال أيضا وإنما لين همزة والثاني سال واد في جهنم بالعذاب"
  },
  {
    "surah": 70,
    "ayah": 2,
    "text": ""
  },
  {
    "surah": 70,
    "ayah": 3,
    "text": "ذي المعارج وهي الروح فما كانت الملاذكة تعرج إليه وصف نفسه بذلك"
  },
  {
    "surah": 70,
    "ayah": 4,
    "text": "واالروح جبريلفي يوم كان مقداره المعنى بعذاب واقع في يوم القيامة"
  },
  {
    "surah": 70,
    "ayah": 5,
    "text": "فاصبر منسوخ بآية السيف"
  },
  {
    "surah": 70,
    "ayah": 6,
    "text": "يرونه يعني العذاب بعيدا غير كائن"
  },
  {
    "surah": 70,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 70,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 70,
    "ayah": 9,
    "text": "والعهن الصوف شبهها به لضعفها وليها قال ابن قتيبة هو الصوف المصبوغ"
  },
  {
    "surah": 70,
    "ayah": 10,
    "text": "ولا يسأل حميم أي لا يسأل قريب قرابته زي لا يكلمهم لشدة الأهوال ومن ضم الياء فالمعنى لا يقال له أين قرابتك"
  },
  {
    "surah": 70,
    "ayah": 11,
    "text": "يبصرونهم أي يعرف الحميم حميمه وهو مع ذلك لا يسأل عن شأنهو المجرم المشرك"
  },
  {
    "surah": 70,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 70,
    "ayah": 13,
    "text": "وفصيلته عشيرته"
