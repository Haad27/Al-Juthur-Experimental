    "ayah": 68,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 69,
    "text": "المزن السحاب"
  },
  {
    "surah": 56,
    "ayah": 70,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 71,
    "text": "تورون تقدحون شجرتها التي يتخذ منها الزنود"
  },
  {
    "surah": 56,
    "ayah": 72,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 73,
    "text": "تذكرة لنار جهنم ومتاعا منفعة للمقرين وهم المسافرون ينزلون القواء"
  },
  {
    "surah": 56,
    "ayah": 74,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 75,
    "text": "ومواقع النجوم مساقطها وقيل هي نجوم القرآن"
  },
  {
    "surah": 56,
    "ayah": 76,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 77,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 78,
    "text": "في كتاب مكنون المصحف وقيل اللوح المحفوظ فعلى الأول المطهرون من الأحداث وعلي الثاني المطهرون الملائكة"
  },
  {
    "surah": 56,
    "ayah": 79,
    "text": "في كتاب مكنون المصحف وقيل اللوح المحفوظ فعلى الأول المطهرون من الأحداث وعلي الثاني المطهرون الملائكة"
  },
  {
    "surah": 56,
    "ayah": 80,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 81,
    "text": "مدهنون مداهنون أي ممالذون الكفار علي الكفر به"
  },
  {
    "surah": 56,
    "ayah": 82,
    "text": "وتجعلون رزقكم زي شكر رزقكم"
  },
  {
    "surah": 56,
    "ayah": 83,
    "text": "إذا بلغت يعني النفس"
  },
  {
    "surah": 56,
    "ayah": 84,
    "text": "وأنتم يعني أهل الميت ونحن ٦ يعني ملك الموت"
  },
  {
    "surah": 56,
    "ayah": 85,
    "text": "وأنتم يعني أهل الميت ونحن ٦ يعني ملك الموت"
  },
  {
    "surah": 56,
    "ayah": 86,
    "text": "مدينين أي مجزيين"
  },
