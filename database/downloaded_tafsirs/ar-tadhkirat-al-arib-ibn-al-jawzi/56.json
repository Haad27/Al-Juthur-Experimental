[
  {
    "surah": 56,
    "ayah": 1,
    "text": "الواقعة القيامة"
  },
  {
    "surah": 56,
    "ayah": 2,
    "text": "ليس لواقعتها أي مجيئها كاذبة زي كذب"
  },
  {
    "surah": 56,
    "ayah": 3,
    "text": "خافضة زي هي خافضة تخفض ناسا وترفع آخرين"
  },
  {
    "surah": 56,
    "ayah": 4,
    "text": "رجت حركت"
  },
  {
    "surah": 56,
    "ayah": 5,
    "text": "وبست فتتت"
  },
  {
    "surah": 56,
    "ayah": 6,
    "text": "والهباء المنبث ما سطع من سنابك الخيل"
  },
  {
    "surah": 56,
    "ayah": 7,
    "text": "أزواجا أصنافا"
  },
  {
    "surah": 56,
    "ayah": 8,
    "text": "فأصحاب الميمنة وهم الذين منزلتهم عن اليمين ما أصحاب الميمنة وهذا تعظيم لشأنهم"
  },
  {
    "surah": 56,
    "ayah": 9,
    "text": "وأصحاب المشأمة هم أصحاب الشمال"
  },
  {
    "surah": 56,
    "ayah": 10,
    "text": "والسابقون إلى الإيمان من كل أمة"
  },
  {
    "surah": 56,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 13,
    "text": "ثلة أي جماعة من الأولين الذين كانوا من زمن آدم إلى نبينا"
  },
  {
    "surah": 56,
    "ayah": 14,
    "text": "وقليل من الآخرين أي من هذه الأمة وقيل جماعة من الأولين أصحاب نبينا وقيل من تابعهم فيكون الكل من هذه الأمة"
  },
  {
    "surah": 56,
    "ayah": 15,
    "text": "موضونة منسوجة"
  },
  {
    "surah": 56,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 17,
    "text": ""
  },
