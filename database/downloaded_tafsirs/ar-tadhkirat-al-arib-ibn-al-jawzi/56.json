  {
    "surah": 56,
    "ayah": 61,
    "text": "وننشئكم فيما لا تعلمون زي نبدل صفاتكم فنجعلكم قردة وختازير"
  },
  {
    "surah": 56,
    "ayah": 62,
    "text": "النشأة الأولى ابتداء الخلق من نطفة وعلقةتذكرون تعتبرون"
  },
  {
    "surah": 56,
    "ayah": 63,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 64,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 65,
    "text": "حطاما أي نبتا لا قمح فيهتفكهون قال الفراء تتعجبون مما نزل بكم في زروعكم وقال ابن قتيبة تندمون"
  },
  {
    "surah": 56,
    "ayah": 66,
    "text": ""
  },
  {
    "surah": 56,
    "ayah": 67,
    "text": ""
