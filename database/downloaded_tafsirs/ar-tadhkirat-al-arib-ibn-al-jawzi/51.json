[
  {
    "surah": 51,
    "ayah": 1,
    "text": "الذاريات الرياح"
  },
  {
    "surah": 51,
    "ayah": 2,
    "text": "فالحاملات السحاب حملت وقرها من الماء"
  },
  {
    "surah": 51,
    "ayah": 3,
    "text": "فالجاريات السفن تجري ميسرة في الماء جريا سهلا"
  },
  {
    "surah": 51,
    "ayah": 4,
    "text": "فالمقسمات الملائكة تقسم الأمور علي ما أمر الله تعالى فجبريل صاحب الوحي والغلظة وميكائيل صاحب الرزق والرحمة وإسرافيل صاحب الصور واللوح وعزرائيل قابض الأرواح"
  },
  {
    "surah": 51,
    "ayah": 5,
    "text": ""
  },
  {
    "surah": 51,
    "ayah": 6,
    "text": "والدين الجزاء"
  },
  {
    "surah": 51,
    "ayah": 7,
    "text": "والحبك الطرائق وهي في اللغة تكسر كل شيء كالرمل إذ مرت به الريح"
  },
  {
    "surah": 51,
    "ayah": 8,
    "text": "والقول المختلف قولهم عن النبي صلى الله عليه وسلم شاعر ومجنون وعن القرآن سحر وكهانة ورجز"
  },
  {
    "surah": 51,
    "ayah": 9,
    "text": "يؤفك أي يصرف عن الإيمان من صرف والهاء في عنه عائدة إلى القرآن"
  },
  {
    "surah": 51,
    "ayah": 10,
    "text": "قتل لعن الخراصون الكذابون"
  },
  {
    "surah": 51,
    "ayah": 11,
    "text": "والغمرة العمى والجهالة"
  },
  {
    "surah": 51,
    "ayah": 12,
    "text": "يسألون استهزاء أيان متى يومهم أي يقع الجزاء"
  },
  {
    "surah": 51,
    "ayah": 13,
    "text": "يوم هم على النار يفتنون أي يحرقون ذوقوا فتنتكم أي حريقكم"
  },
  {
    "surah": 51,
    "ayah": 14,
    "text": "يوم هم على النار يفتنون أي يحرقون ذوقوا فتنتكم أي حريقكم"
  },
  {
    "surah": 51,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 51,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 51,
    "ayah": 17,
    "text": "ما يهجعون أي ينامون والمعنى كانوا يسهرون قليلا من الليل وبعضهم يقول ما بمعنى الذي والمعنى كانوا قليلا من الليل هجوعهم"
  },
  {
    "surah": 51,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 51,
    "ayah": 19,
    "text": "والساذل الطالب المحروم المتعفف الذي لا يسأل"
