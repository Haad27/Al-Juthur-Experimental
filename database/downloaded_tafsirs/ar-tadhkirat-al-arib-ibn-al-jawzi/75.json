    "ayah": 24,
    "text": "باسرة عابسة"
  },
  {
    "surah": 75,
    "ayah": 25,
    "text": "والفاقرة الداهية"
  },
  {
    "surah": 75,
    "ayah": 26,
    "text": "بلغت يعني النفس التراقي العظام المكتنفة لثغرة النحر عن يمين وشمال"
  },
  {
    "surah": 75,
    "ayah": 27,
    "text": "من راق من يرقي"
  },
  {
    "surah": 75,
    "ayah": 28,
    "text": "وظن أيقن"
  },
  {
    "surah": 75,
    "ayah": 29,
    "text": "الساق بالساق شدة الدنيا بشدة الآخرة"
  },
  {
    "surah": 75,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 75,
    "ayah": 31,
    "text": "فلا صدق أي لم يصدق وهو أبو جهل"
