[
  {
    "surah": 75,
    "ayah": 1,
    "text": "لا زائدة"
  },
  {
    "surah": 75,
    "ayah": 2,
    "text": "النفس اللوامة المؤمنة تلوم نفسها في الدنيا على التقصير"
  },
  {
    "surah": 75,
    "ayah": 3,
    "text": ""
  },
  {
    "surah": 75,
    "ayah": 4,
    "text": "والبنان في الأنفال"
  },
  {
    "surah": 75,
    "ayah": 5,
    "text": "ليفجر أمامة ليكذب بما أمامه من البعث والحساب"
  },
  {
    "surah": 75,
    "ayah": 6,
    "text": "يسأل تكذيبا"
  },
  {
    "surah": 75,
    "ayah": 7,
    "text": "برق شخص يوم القيامة"
  },
  {
    "surah": 75,
    "ayah": 8,
    "text": "وخسف ذهب وضوءه"
  },
  {
    "surah": 75,
    "ayah": 9,
    "text": "وجمع الشمس والقمر قال عطاء بن يسار يجمعان ثم يقذفان في البحروقيل في النار"
  },
  {
    "surah": 75,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 75,
    "ayah": 11,
    "text": "وزر ملجأ"
  },
  {
    "surah": 75,
    "ayah": 12,
    "text": "المستقر المنتهى"
  },
  {
    "surah": 75,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 75,
    "ayah": 14,
    "text": "بصيرة أي بل على الإنسان من نفسه بصيرة أي رقباء وهي الجوارح"
  },
  {
    "surah": 75,
    "ayah": 15,
    "text": "والمعاذير جمع عذر"
  },
  {
    "surah": 75,
    "ayah": 16,
    "text": "لا تحرك به لسانك كان الوحي إذا نزل على النبي صلى الله عليه وسلم يحرك لسانه لحفظ قبل فراغ جبريل فنزلت هذه الآية"
  },
  {
    "surah": 75,
    "ayah": 17,
    "text": "جمعه وقرآنه أي ضمه في صدرك"
  },
  {
    "surah": 75,
    "ayah": 18,
    "text": ""
  },
  {
