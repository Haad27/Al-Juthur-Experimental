[
  {
    "surah": 69,
    "ayah": 1,
    "text": "الحاقة القيامة فيها حواق الأمور"
  },
  {
    "surah": 69,
    "ayah": 2,
    "text": "ما الحاقة تفخيم لشأنها"
  },
  {
    "surah": 69,
    "ayah": 3,
    "text": "وما أدراك لأنك لم تر ما فيها من الأهواال"
  },
  {
    "surah": 69,
    "ayah": 4,
    "text": "والقارعة القيامة لأنها تقرع بالأهوال"
  },
  {
    "surah": 69,
    "ayah": 5,
    "text": "والطاغية طغيانهم وكفرهم"
  },
  {
    "surah": 69,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 7,
    "text": "حسوما أي تباعافيها أي في تلك الليالي والزيامأعجاز نخل زي أصول نخل خاوية بالية"
  },
  {
    "surah": 69,
    "ayah": 8,
    "text": "من باقية أي من بقايا"
  },
  {
    "surah": 69,
    "ayah": 9,
    "text": "بالخاطئة أي بالخطأ"
  },
  {
    "surah": 69,
    "ayah": 10,
    "text": "رابية زائدة علي اأخذات"
  },
  {
    "surah": 69,
    "ayah": 11,
    "text": "والجارية السفينة"
  },
  {
    "surah": 69,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 13,
    "text": "نفخة واحدة وهي الأولى"
  },
  {
    "surah": 69,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 17,
    "text": "على أرجائها جوانبها"
  },
  {
    "surah": 69,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 20,
    "text": "ظننت أيقنت"
  },
  {
    "surah": 69,
    "ayah": 21,
    "text": "راضية أي مرضية"
  },
  {
    "surah": 69,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 23,
    "text": "قطوفها ما قطف من ثمارها"
  },
  {
    "surah": 69,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 26,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 27,
    "text": "يا ليتها يعني الموتة التي كانت في الدنيا كانت القاضية القاطعة للحياة فكأنه تمنى أن لم يبعث"
  },
  {
    "surah": 69,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 29,
    "text": "والسلطان الحجة وقيل الملك"
  },
  {
    "surah": 69,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 31,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 32,
    "text": "فاسلكوه أي فاسلكوها فيه ومثل هذا قول العرب أدخل الخاتم في يدك لأن المعنى معروف"
  },
  {
    "surah": 69,
    "ayah": 33,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 34,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 35,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 36,
    "text": "والغسلين صديد أهل النار"
  },
  {
    "surah": 69,
    "ayah": 37,
    "text": "والخاطئون الكافرون"
  },
  {
    "surah": 69,
    "ayah": 38,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 39,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 40,
    "text": "لقول رسول يعني محمد صلى الله عليه وسلم وقيل جبريل والمعنى قول رسول عن الله فلما كان في ذكر الرسول ما يدل على المرسل اكتفى بذلك"
  },
  {
    "surah": 69,
    "ayah": 41,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 42,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 43,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 44,
    "text": "ولو تقول علينا محمد"
  },
  {
    "surah": 69,
    "ayah": 45,
    "text": "لأخذنا منه باليمين أي بالقوة"
  },
  {
    "surah": 69,
    "ayah": 46,
    "text": "والوتين عرق يتصل بالقلب فلا يحجزنا عنه منكم أحد"
  },
  {
    "surah": 69,
    "ayah": 47,
    "text": "والوتين عرق يتصل بالقلب فلا يحجزنا عنه منكم أحد"
  },
  {
    "surah": 69,
    "ayah": 48,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 49,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 50,
    "text": "وإنه يعني القرآن لحسرة علي الكافرين يوم القيامة رذ لم يؤمنوا به"
  },
  {
    "surah": 69,
    "ayah": 51,
    "text": "وإنه لحق اليقين أضافه إلى نفسه لاختلاف اللفظين كقوله ولدار الآخرة"
  },
  {
    "surah": 69,
    "ayah": 52,
    "text": ""
  }
