[
  {
    "surah": 15,
    "ayah": 1,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 2,
    "text": "ربما يود الذين كفروا اذا خرج الموحدون من النار ودوا ذلك"
  },
  {
    "surah": 15,
    "ayah": 3,
    "text": "ذرهم ياكلوا منسوخ باية السيف"
  },
  {
    "surah": 15,
    "ayah": 4,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 5,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 7,
    "text": "لوما بمعنى هلابالملائكه يشهدون بصدقك"
  },
  {
    "surah": 15,
    "ayah": 8,
    "text": "الا بالحق أي بالعذاب على من لا يؤمن وما كانوا اذامنظرين أي وما كان المشركون اذا منظرين عند نزول الملائكه"
  },
  {
    "surah": 15,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 10,
    "text": "لقد ارسلنا من قبلك يعني رسلا فحذفوالشيع الفرق"
  },
  {
    "surah": 15,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 12,
    "text": "كذلك نسلكه يعني الشرك"
  },
  {
    "surah": 15,
    "ayah": 13,
    "text": "وقد خلت سنة الاولين أي مضت سنة الله في اهلاك المكذبين"
  },
  {
    "surah": 15,
    "ayah": 14,
    "text": "يعرجون يصعدون"
  },
  {
    "surah": 15,
    "ayah": 15,
    "text": "سكرت أبصارنا أي اخذ بأبصارنا وشبه علينا والمعنى لو أقدرناهم على صعود السماء لقالوا هذا"
  },
  {
    "surah": 15,
    "ayah": 16,
    "text": "بروجا وهي منازل الشمس والقمر"
  },
  {
    "surah": 15,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 19,
    "text": "والموزون المعلوم"
  },
  {
    "surah": 15,
    "ayah": 20,
    "text": "ومن لستم له برازقين وهم المماليك"
  },
  {
    "surah": 15,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 22,
    "text": "لواقح أي ملقحه أي انها تلقح الشجر وتلقح السحاب كانها تنتج ذلكفأستقيناكموه أي جعلناه سقيا لكمبخازنين أي لست خزائنه بايديكم"
  },
  {
    "surah": 15,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 24,
    "text": "المستقدم المتقدم وهو من مات والمستاخر المتاخر وهو من لم يمت"
  },
  {
    "surah": 15,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 26,
    "text": "والصلصال الطين اليابس الذي لم تمسه نار فاذا نقرته صلوالحما جمع حماة وهو الطين الاسود المتغير الريح والمسنون المتغير الرائحه أيضا"
  },
  {
    "surah": 15,
    "ayah": 27,
    "text": "والجان أبو الجنونار السموم الريح الحاره فيها نار"
  },
  {
    "surah": 15,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 29,
    "text": ""
