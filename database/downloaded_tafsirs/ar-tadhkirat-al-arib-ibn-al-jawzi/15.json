  },
  {
    "surah": 15,
    "ayah": 38,
    "text": "الوقت المعلوم يعني المعلوم بموت الخلائق فيه"
  },
  {
    "surah": 15,
    "ayah": 39,
    "text": "لازينن لهم يعني الباطل فحذف"
  },
  {
    "surah": 15,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 41,
    "text": "هذا صراط يعني الاخلاص وعلي بمعنى الي"
  },
  {
    "surah": 15,
    "ayah": 42,
    "text": "والسلطان بمعنى الحجه"
