  {
    "surah": 71,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 71,
    "ayah": 20,
    "text": "فجاجا أي طرقا واسعة"
  },
  {
    "surah": 71,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 71,
    "ayah": 22,
    "text": "كبارا أي كبيرا ومكرهم أن الرؤساء أن الرؤساء منعوا أتباعهم عن الإيمان به"
  },
  {
    "surah": 71,
    "ayah": 23,
    "text": "لا تذرن لا تدعن عباده أصنامكم ودا وما بعده أصنامهم"
  },
  {
    "surah": 71,
    "ayah": 24,
    "text": "وقد أضلوا يعني الأصنام وقيل الرؤساء"
  },
  {
    "surah": 71,
    "ayah": 25,
    "text": "مما خطاياهم ما صلة"
  },
  {
    "surah": 71,
    "ayah": 26,
    "text": "ديارا أي أحدا"
  },
  {
    "surah": 71,
    "ayah": 27,
    "text": "يضلوا عبادك لما أخبره الله عز وجل أنهم لا يلدون مؤمنا قال هذا"
  },
  {
    "surah": 71,
    "ayah": 28,
    "text": "ولوالدي قال الحسن كانا مؤمنينتبارا هلاكا"
