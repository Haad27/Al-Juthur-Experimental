    "surah": 71,
    "ayah": 17,
    "text": "أنبتكم من الأرض أي مبتدؤكم منها وهو آدم والمعنى فتبتم نباتا"
  },
  {
    "surah": 71,
    "ayah": 18,
    "text": ""
