[
  {
    "surah": 40,
    "ayah": 1,
    "text": "قال ابن عباس حم بعض حروف الرحمن وقال أبو العالية الحاء مفتاح حميد والميم مفتاح مجيد"
  },
  {
    "surah": 40,
    "ayah": 2,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 3,
    "text": "والثواب جمع توبةوالطول الفضل"
  },
  {
    "surah": 40,
    "ayah": 4,
    "text": "يجادل يخاصم في الآيات بالتكذيب"
  },
  {
    "surah": 40,
    "ayah": 5,
    "text": "ليأخذوه ليقتلوه"
  },
  {
    "surah": 40,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 7,
    "text": "وسعت أي وسعت رحمتك وعلمك كل شيء"
  },
  {
    "surah": 40,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 10,
    "text": "لمقت الله مقتوا أنفسهم لقبح ما فعلوا فخوطبوا بهذه الآية"
  },
  {
    "surah": 40,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 12,
    "text": "ذلكم يعني العذاب الذي نزل بهم"
  },
  {
    "surah": 40,
    "ayah": 13,
    "text": "والرزق المطر"
  },
  {
    "surah": 40,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 15,
    "text": "رفيع الدرجات قال ابن عباس رافع السمواتوالروح الوحييوم التلاق يلتقي أهل السماء بأهل الأرض وقال قتادة يلتقي الخالق والمخلوق والخلق"
  },
  {
    "surah": 40,
    "ayah": 16,
    "text": "لمن الملك يقوله عز وجل إذا مات الخلالق ويجيب نفسه بقوله لله"
  },
  {
    "surah": 40,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 18,
    "text": "والآزفة القيامةكاظمين مغمومين ممتلئين خوفاما للظالمين أي للكافرين والحميم القريب"
  },
  {
    "surah": 40,
    "ayah": 19,
    "text": "والخائنة الخيانة وهو نظر العين إلى ما نهيت عنه"
  },
  {
    "surah": 40,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 25,
    "text": "اقتلوا أبناء الذين آمنوا أي اعتدوا عليهم بالقتل"
  },
  {
    "surah": 40,
    "ayah": 26,
    "text": "ذروني أقتل موسى كان في خاصة فرعون من يمنعه من قتله خوفا من الهلاك وليدع ربك الذي يزعم أنه أرسله فليمنعه من القتليبدل دينكم عبادتكم إياي الفساد بتغيير أحكامها"
  },
  {
    "surah": 40,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 28,
    "text": "واسم المؤمن حزبيل"
  },
  {
    "surah": 40,
    "ayah": 29,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 30,
    "text": "الأحزاب الأمم المكذبة"
  },
  {
    "surah": 40,
    "ayah": 31,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 32,
    "text": "ويوم التناد عند النفخ في الصور ينادي بعض الناس بعضا ويولون مدبرين هربا من النار"
  },
  {
    "surah": 40,
    "ayah": 33,
    "text": "ويوم التناد عند النفخ في الصور ينادي بعض الناس بعضا ويولون مدبرين هربا من النار"
  },
  {
    "surah": 40,
    "ayah": 34,
    "text": "يوسف هو ابن يعقوب والبينات الدلالات على التوحيد"
  },
  {
    "surah": 40,
    "ayah": 35,
    "text": "يجادلون في آيات الله بالتكذيب لها والسلطان الحجة كبر جدالهم مقتاكذلك أي كما طبع على قلوبهم حتى تكذبوا وجادلوا"
  },
  {
    "surah": 40,
    "ayah": 36,
    "text": "الأسباب الأبواب"
  },
  {
    "surah": 40,
    "ayah": 37,
    "text": "والتباب البطلان والخسار"
  },
  {
    "surah": 40,
    "ayah": 38,
    "text": ""
  },
