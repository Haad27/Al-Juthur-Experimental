  {
    "surah": 26,
    "ayah": 49,
    "text": "فلسوف تعلمون اللام للتوكيد"
  },
  {
    "surah": 26,
    "ayah": 50,
    "text": "لا ضير أي لا ضرر"
  },
  {
    "surah": 26,
    "ayah": 51,
    "text": "أن كنا أي لأن كنا أول المؤمنين بآيات موسى في هذه الحال"
  },
  {
    "surah": 26,
    "ayah": 52,
    "text": "متبعون أي يتبعكم فرعون وقومه"
  },
  {
    "surah": 26,
    "ayah": 53,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 54,
    "text": "شرذمة أي طائفة وإنما استقلهم بالإضافة إلى جنده"
  },
  {
    "surah": 26,
    "ayah": 55,
    "text": "لغائظون أي مغضبون"
  },
  {
    "surah": 26,
    "ayah": 56,
    "text": "حاذرون أي مستعدون وحذرون متيقظون وقيل هما لغتان بمعنى"
  },
  {
    "surah": 26,
    "ayah": 57,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 58,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 59,
    "text": "وكذلك أي الأمر كما وصفنا وأورثناها أي جعلناها أملاكا ل بني إسرائيل وما رجعوا إليها لأن مساكنهم الشام إنما ملكوها"
  },
  {
    "surah": 26,
    "ayah": 60,
    "text": "فأتبعوهم لحقوهم مشرقين حين شرقت الشمس"
  },
  {
    "surah": 26,
    "ayah": 61,
    "text": "تراءى أي تقابلا"
  },
  {
    "surah": 26,
    "ayah": 62,
    "text": "سيهدين يدلني على طريق النجاة"
  },
  {
    "surah": 26,
    "ayah": 63,
    "text": "فانفلق فيه إضمار فضرب والطود الجبل"
  },
  {
    "surah": 26,
    "ayah": 64,
    "text": "وأزلفنا قربنا أصحاب فرعون من الغرق"
  },
  {
    "surah": 26,
    "ayah": 65,
    "text": ""
