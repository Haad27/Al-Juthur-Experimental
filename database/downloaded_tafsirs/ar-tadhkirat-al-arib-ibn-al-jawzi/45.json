  {
    "surah": 45,
    "ayah": 13,
    "text": "جميعا منه أي من فضله"
  },
  {
    "surah": 45,
    "ayah": 14,
    "text": "يغفروا للذين لا يرجون أيام الله كان المشركون يؤذون المسلمين فنزلت الآية و يرجو بمعنى يخافون و أيام الله وقائعه في الأمم ليجزي قوما يعني الكفار فكأنه قال لا تكافئوهم نحن نكافئهم ثم نسخ هذا بقوله فاقتلوا المشركين"
  },
  {
    "surah": 45,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 16,
    "text": "والحكم الفهم والطيبات المن والسلوى"
  },
  {
    "surah": 45,
    "ayah": 17,
    "text": "بينات من الأمر وهو بيان الحلال والحرام"
  },
  {
    "surah": 45,
    "ayah": 18,
    "text": "الذين لا يعلمون الكفار"
  },
  {
    "surah": 45,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 45,
