[
  {
    "surah": 91,
    "ayah": 1,
    "text": "وضحاها حين يصفو ضوءها بعد الطلوع"
  },
  {
    "surah": 91,
    "ayah": 2,
    "text": ""
  },
  {
    "surah": 91,
    "ayah": 3,
    "text": "جلاها بينها لأنه إذا بسط النهار تبين وقيل جلاها يعني الظلمة فكنى عنها ولم تذكر"
  },
  {
    "surah": 91,
    "ayah": 4,
    "text": "يغشاها أي يغشى الشمس حين تغيب"
  },
  {
    "surah": 91,
    "ayah": 5,
    "text": "وما بمعنى من"
  },
  {
    "surah": 91,
    "ayah": 6,
    "text": "طحاها بسطها"
  },
  {
    "surah": 91,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 91,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 91,
    "ayah": 9,
    "text": "من زكاها أي زكي نفسه بطاعة الله"
  },
  {
    "surah": 91,
    "ayah": 10,
    "text": "ودساها أي دسها وأخفاها بالفجور لأن صاحب الذنوب يخفي نفسه ويقمعها"
  },
  {
    "surah": 91,
    "ayah": 11,
    "text": "بطغواها بطغيانها"
  },
  {
    "surah": 91,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 91,
    "ayah": 13,
    "text": "وسقياها شربها من الماء"
  },
  {
    "surah": 91,
    "ayah": 14,
    "text": "فدمدم أطبق عليهم العذابفسواها أي سوى الدمدمة عليهم فأهلك الكل"
  },
  {
    "surah": 91,
    "ayah": 15,
    "text": "ولا يخاف عقباها أي لا يخاف عقبى ما صنع بهم"
  }
]