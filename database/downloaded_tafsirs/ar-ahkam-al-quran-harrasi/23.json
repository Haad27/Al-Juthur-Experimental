    "surah": 23,
    "ayah": 1,
    "text": ""
  },
  {
    "surah": 23,
    "ayah": 2,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿والّذِينَ هُمْ في صَلاَتِهِم خَاشِعُونَ﴾</span>،  الآية :[ ٢ ] :<br />\nوالمراد به عند المفسرين أن لا يتجاوز بصره مصلاه،  ولا يلتفت ولا يحرك يديه،  وقال عليه الصلاة والسلام :\" اسكنوا في الصلاة،  وكفوا أيديكم في الصلاة \"."
  },
  {
    "surah": 23,
    "ayah": 3,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿والّذِينَ هُمْ عَنِ اللَغْو مُعْرِضُونَ﴾</span>،  الآية :[ ٣ ] :<br />\nاللغو : الباطل،  وجعل قتادة ذلك وصفاً للمصلين،  أي إن المؤمن في الصلاة معرض عن اللغو والرفث."
  },
  {
    "surah": 23,
    "ayah": 4,
    "text": ""
  },
  {
    "surah": 23,
    "ayah": 5,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿والّذِينَ هُمْ لِفُروجِهِم حَافِظُونَ،  إلاَّ عَلَى أَزْوَاجِهِم أَوْ مَا مَلَكَتْ أَيْمَانُهُم﴾</span>،  الآية :[ ٥،  ٦ ] :<br />\nيقتضي تحريم المتعة،  إذ ليست بزوجة ولا ملك يمين."
  },
  {
    "surah": 23,
    "ayah": 6,
    "text": "قوله :<span class=\"book-ayah text-primary\">﴿إلاَّ عَلَى أَزْوَاجِهِم أَوْ مَا مَلَكَتْ أَيْمَانُهُم﴾</span>. <br />\nلا بد أن يكون خطاباً للرجال،  فإن المرأة لا تستحل بملك اليمين شيئاً من أمر البضع."
  },
  {
    "surah": 23,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 23,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 23,
    "ayah": 9,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿والّذِينَ هُمْ عَلَى صَلَوَاتِهِم يُحَافِظُونَ﴾</span>،  الآية :[ ٩ ] :<br />\nالمحافظة عليها في الوقت،  ويحتمل أنهم يحافظون على مواقيتها وركوعها،  ومراعاة حدودها وشروطها."
  },
