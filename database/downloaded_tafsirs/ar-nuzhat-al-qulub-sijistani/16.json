    "surah": 16,
    "ayah": 52,
    "text": "<span class=\"book-ayah text-primary\">﴿وَاصِباً﴾</span> أي دائما."
  },
  {
    "surah": 16,
    "ayah": 53,
    "text": "<span class=\"book-ayah text-primary\">﴿تَجْأَرُونَ﴾</span> أي ترفعون أصواتكم بالدعاء."
