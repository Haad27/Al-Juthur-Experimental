  {
    "surah": 16,
    "ayah": 4,
    "text": "<span class=\"book-ayah text-primary\">﴿خَصِيمٌ﴾</span> أي شديد الخصومة."
  },
  {
    "surah": 16,
    "ayah": 5,
    "text": "<span class=\"book-ayah text-primary\">﴿دِفْءٌ﴾</span>: ما استدفئ به من الأكسية والأخبية وغير ذلك."
  },
  {
    "surah": 16,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿تَسْرَحُونَ﴾</span>: أي ترسلون الإبل غداة إلى الرعي. و <span class=\"book-ayah text-primary\">﴿تُرِيحُونَ﴾</span>: تردونها عشيا إلى مراحها."
  },
  {
    "surah": 16,
    "ayah": 7,
    "text": "<span class=\"book-ayah text-primary\">﴿بِشِقِّ ٱلأَنفُسِ﴾</span> أي بمشقة الأنفس."
  },
  {
    "surah": 16,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 10,
    "text": "<span class=\"book-ayah text-primary\">﴿تُسِيمُونَ﴾</span>: أي ترعون إبلكم."
  },
  {
    "surah": 16,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 14,
    "text": "<span class=\"book-ayah text-primary\">﴿مَوَاخِرَ فِيهِ﴾</span> أي فواعل، يقال: مخرت السفينة إذا جرت فشقت الماء بصدرها، ومنه مخر الأرض إنما هو شق الماء لها."
  },
  {
    "surah": 16,
    "ayah": 15,
    "text": "<span class=\"book-ayah text-primary\">﴿رَوَاسِيَ﴾</span> أي ثوابت، يعني جبالا.<span class=\"book-ayah text-primary\">﴿تَمِيدَ﴾</span>: تحرك وتميل، وقوله تبارك اسمه <span class=\"book-ayah text-primary\">﴿وَأَلْقَىٰ فِي الْأَرْضِ رَوَاسِيَ أَنْ تَمِيدَ بِكُمْ﴾</span> أي لئلا تميد بكم."
  },
  {
    "surah": 16,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 17,
    "text": ""
