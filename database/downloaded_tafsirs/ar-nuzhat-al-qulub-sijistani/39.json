  {
    "surah": 39,
    "ayah": 3,
    "text": "<span class=\"book-ayah text-primary\">﴿زُلْفَىۤ﴾</span>: أي قربى، الواحدة قربة وزلفى."
  },
  {
    "surah": 39,
    "ayah": 4,
    "text": ""
  },
  {
    "surah": 39,
    "ayah": 5,
    "text": "<span class=\"book-ayah text-primary\">﴿يُكَوِّرُ ٱللَّيْـلَ عَلَى ٱلنَّهَـارِ﴾</span> أي يدخل هذا على هذا. وأصل التكوير اللف والجمع، ومنه كور العمامة."
  },
  {
    "surah": 39,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿ظُلُمَاتٍ ثَلاَثٍ﴾</span> قيل: ظلمة المشيمة، وظلمة الرحم، وظلمة البطن."
  },
  {
    "surah": 39,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 39,
    "ayah": 8,
    "text": "<span class=\"book-ayah text-primary\">﴿خَوَّلَهُ﴾</span>: أي أعطاه."
  },
  {
    "surah": 39,
    "ayah": 9,
    "text": "<span class=\"book-ayah text-primary\">﴿قَانِتٌ آنَآءَ ٱلَّيلِ﴾</span> أي مضل ساعات الليل، وأصل القنوت: الطاعة. <span class=\"book-ayah text-primary\">﴿آنَآءَ ٱلَّيلِ﴾</span>: ساعاته، واحدها أنى وإنى وإنى."
  },
