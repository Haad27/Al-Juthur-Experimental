  },
  {
    "surah": 20,
    "ayah": 4,
    "text": "<span class=\"book-ayah text-primary\">﴿ٱلْعُلَى﴾</span> جمع عليا."
  },
  {
    "surah": 20,
    "ayah": 5,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿ٱلثَّرَىٰ﴾</span>: أي التراب الندي، وهو الذي تحت الظاهر من وجه الأرض."
  },
  {
    "surah": 20,
    "ayah": 7,
    "text": "<span class=\"book-ayah text-primary\">﴿تَجْهَرْ بِٱلْقَوْلِ﴾</span>: أي ترفع صوتك."
  },
  {
    "surah": 20,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 10,
    "text": "<span class=\"book-ayah text-primary\">﴿آنَسْتُ نَاراً﴾</span> انظر آية ٦ من النساء.<span class=\"book-ayah text-primary\">﴿قَبَسٍ﴾</span> أي شعلة من النار."
  },
  {
    "surah": 20,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 12,
    "text": "<span class=\"book-ayah text-primary\">﴿طُوًى﴾</span> وطوى يقرآن جميعا، ومن جعله اسم أرض لم يصرفه؛ ومن جعله اسم الوادي صرفه، لأنه مذكر، ومن جعله مصدرا كقولك: ناديته طوى وثنى أي مرتين - صرفه أيضا."
  },
  {
    "surah": 20,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 15,
    "text": "<span class=\"book-ayah text-primary\">﴿أُخْفِيهَا﴾</span> أسترها وأظهرها أيضا، وهو من الأضداد، من أخفيت. وأخفيها: أظهرها أيضا لا غير، من خفيت."
  },
  {
    "surah": 20,
    "ayah": 16,
    "text": "<span class=\"book-ayah text-primary\">﴿تَرْدَىٰ﴾</span>: تهلك."
  },
  {
    "surah": 20,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 18,
    "text": "<span class=\"book-ayah text-primary\">﴿أَهُشُّ بِهَا عَلَىٰ غَنَمِي﴾</span> أضرب بها الأغصان ليسقط ورقها على غنمي فتأكله <span class=\"book-ayah text-primary\">﴿مَآرِبُ أُخْرَىٰ﴾</span> أي حوائج، واحدها مأربة ومأربة ومأربة."
  },
  {
    "surah": 20,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 21,
    "text": "<span class=\"book-ayah text-primary\">﴿سَنُعِيدُهَا سِيرَتَهَا الْأُولَىٰ﴾</span> أي سنردها عصا كما كانت."
  },
  {
    "surah": 20,
    "ayah": 22,
    "text": "<span class=\"book-ayah text-primary\">﴿وَاضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ﴾</span>: أي اجمع يدك إلى جيبك. والجناح ما بين أسفل العضد إلى الإبط. وقوله تعالى:<span class=\"book-ayah text-primary\">﴿ وَٱضْمُمْ إِلَيْكَ جَنَاحَكَ مِنَ ٱلرَّهْبِ ﴾</span><span class=\"surah-ref\">[القصص: ٣٢]</span> يقال: الجناح هاهنا اليد، ويقال العصا."
  },
  {
    "surah": 20,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 24,
    "text": "<span class=\"book-ayah text-primary\">﴿طَغَىٰ﴾</span>: ترفع وعلا حتى جاوز أوكاد، ومنه<span class=\"book-ayah text-primary\">﴿ لَمَّا طَغَا ٱلْمَآءُ ﴾</span><span class=\"surah-ref\">[الحاقة: ١١]</span> أي علا وجاوز أوكاد."
  },
  {
    "surah": 20,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 26,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 27,
    "text": "<span class=\"book-ayah text-primary\">﴿عُقْدَةً مِّن لِّسَانِي﴾</span> يعني رتة كانت في لسانه أي حبسة. قال أبو عمر: سمعت المبرد يقول: طول السكوت حبسة."
  },
  {
    "surah": 20,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 29,
    "text": "<span class=\"book-ayah text-primary\">﴿وَزِيراً مِّنْ أَهْلِي﴾</span> أصل الوزارة من الوزر: وهو الحمل، كأن الوزير يحمل عن السلطان الثقل."
  },
  {
    "surah": 20,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 31,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 32,
    "text": "<span class=\"book-ayah text-primary\">﴿أَزْرِي﴾</span> عوني وظهري: ومنه فآزره أي فأعانه."
  },
  {
    "surah": 20,
    "ayah": 33,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 34,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 35,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 36,
    "text": "<span class=\"book-ayah text-primary\">﴿سُؤْلَكَ﴾</span>: أي أمنيتك وطلبتك."
  },
  {
    "surah": 20,
    "ayah": 37,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 38,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 39,
    "text": "<span class=\"book-ayah text-primary\">﴿تُصْنَعَ عَلَىٰ عَيْنِيۤ﴾</span> أي تربى وتغذى بمرأى مني، لا أكلك إلى غيري."
  },
  {
    "surah": 20,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 41,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 42,
    "text": "<span class=\"book-ayah text-primary\">﴿تَنِيَا﴾</span>: تفترا."
  },
  {
    "surah": 20,
    "ayah": 43,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 44,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 45,
    "text": "<span class=\"book-ayah text-primary\">﴿يَفْرُطَ عَلَيْنَآ﴾</span> أي يعجل إلى عقوبتنا، يقال فرط يفرط إذا تقدم أو تعجل، وأفرط يفرط إذا اشتد، وفرد يفرط إذا قصر، ومعناه كله التقديم."
  },
  {
    "surah": 20,
    "ayah": 46,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 47,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 48,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 49,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 50,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 51,
    "text": "<span class=\"book-ayah text-primary\">﴿بَالُ﴾</span>: حال."
  },
  {
    "surah": 20,
    "ayah": 52,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 53,
    "text": "<span class=\"book-ayah text-primary\">﴿شَتَّىٰ﴾</span>: أي مختلف. وقوله عز اسمه: <span class=\"book-ayah text-primary\">﴿مِّن نَّبَاتٍ شَتَّىٰ﴾</span> يقال: مختلف الألوان والطعوم."
  },
  {
    "surah": 20,
    "ayah": 54,
    "text": "(نهى): عقول، واحدها نهية."
  },
  {
    "surah": 20,
    "ayah": 55,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 56,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 57,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 58,
    "text": "<span class=\"book-ayah text-primary\">﴿سُوًى﴾</span> إذا كسر أوله وضم قصر، وإذا فتح مد كقوله<span class=\"book-ayah text-primary\">﴿ إِلَىٰ كَلِمَةٍ سَوَآءٍ بَيْنَنَا وَبَيْنَكُمْ ﴾</span><span class=\"surah-ref\">[آل عمران: ٦٤]</span>: أي عدل ونصف، يقال: دعاك إلى السواء فأقبل، أي إلى النصفة، وسواء كل شيء وسطه. وقوله تعالى: <span class=\"book-ayah text-primary\">﴿مَكَاناً سُوًى﴾</span> وسوى: أي وسطا بين الموضعين."
  },
  {
    "surah": 20,
    "ayah": 59,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 60,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 61,
    "text": "<span class=\"book-ayah text-primary\">﴿يُسْحِتَكُم﴾</span>: يهلككم ويستأصلكم."
  },
  {
    "surah": 20,
    "ayah": 62,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 63,
    "text": "<span class=\"book-ayah text-primary\">﴿بِطَرِيقَتِكُمُ الْمُثْلَىٰ﴾</span> أي بسنتكم ودينكم وما أنتم عليه. والمثلى تأنيث الأمثل."
  },
  {
    "surah": 20,
    "ayah": 64,
    "text": "<span class=\"book-ayah text-primary\">﴿صَفّاً﴾</span> ذكر أبو عبيدة فيه وجهين، ثم ائتوا صفا: أي صفوفا. والصف أيضا المصلى الذي يصلى فيه. وحكى عن بعضهم أنه قال: ما استطعت أن آتي الصف اليوم: أي المصلى."
  },
  {
    "surah": 20,
    "ayah": 65,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 66,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 67,
    "text": "<span class=\"book-ayah text-primary\">﴿أَوْجَسَ فِي نَفْسِهِ خِيفَةً﴾</span> أحس وأضمر في نفسه خوفا."
  },
  {
    "surah": 20,
    "ayah": 68,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 69,
    "text": "<span class=\"book-ayah text-primary\">﴿تَلْقَفْ﴾</span> وتلقم وتلهم بمعنى واحد أي تبتلع. ويقال تلقفه والتقفه إذا أخذه أخذا سريعا."
  },
  {
    "surah": 20,
    "ayah": 70,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 71,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 72,
    "text": "<span class=\"book-ayah text-primary\">﴿فَاقْضِ مَا أَنْتَ قَاضٍ﴾</span> أي فامض ما أنت ممض. انظر ٧١ من يونس."
  },
  {
    "surah": 20,
    "ayah": 73,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 74,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 75,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 76,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 77,
    "text": "<span class=\"book-ayah text-primary\">﴿يَبَساً﴾</span> أي يابسا.<span class=\"book-ayah text-primary\">﴿دَرَكاً﴾</span>: لحاقا، كقوله <span class=\"book-ayah text-primary\">﴿لاَّ تَخَافُ دَرَكاً وَلاَ تَخْشَىٰ﴾</span>.<br>"
  },
  {
    "surah": 20,
    "ayah": 78,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 79,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 80,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 81,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 82,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 83,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 84,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 85,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 86,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 87,
    "text": "<span class=\"book-ayah text-primary\">﴿حُمِّلْنَا أَوْزَارًا مِنْ زِينَةِ الْقَوْمِ﴾</span> أي أثقالا من حليهم. انظر ٣١ من الأنعام."
  },
  {
    "surah": 20,
    "ayah": 88,
    "text": "<span class=\"book-ayah text-primary\">﴿عِجْلاً جَسَداً لَّهُ خُوَارٌ﴾</span> أي صورة لا روح فيها إنما هي جسد فقط. والخوار قال أبو عمر: أصحاب الحديث يقولون إن الله عز وجل جعل الخوار فيه، كانت الريح تدخل فيه فيسمع له صوت.<span class=\"book-ayah text-primary\">﴿خُوَارٌ﴾</span>: صوت البقر."
  },
  {
    "surah": 20,
    "ayah": 89,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 90,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 91,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 92,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 93,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 94,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 95,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 96,
    "text": "<span class=\"book-ayah text-primary\">﴿فَقَبَضْتُ قَبْضَةً مِنْ أَثَرِ الرَّسُولِ﴾</span> يقول: أخذت ملء كفي من تراب موطئ فرس جبريل عليه السلام. وتقرأ: فقبضت قبضة، أي أخذت بأطراف أصابعي."
  },
  {
    "surah": 20,
    "ayah": 97,
    "text": "<span class=\"book-ayah text-primary\">﴿ظَلْتَ عَلَيْهِ عَاكِفاً﴾</span> يقال: ظل يفعل كذا، إذا فعله نهارا، وبات يفعل كذا إذا فعله ليلا <span class=\"book-ayah text-primary\">﴿مِسَاسَ﴾</span> أي مماسة ومخالطة.<span class=\"book-ayah text-primary\">﴿لَّنُحَرِّقَنَّهُ﴾</span> يعني بالنار. ونحرقنه: نبردنه بالمبارد.<span class=\"book-ayah text-primary\">﴿لَنَنْسِفَنَّهُ فِي الْيَمِّ﴾</span> أي نطيرنه ونذرينه في البحر."
  },
  {
    "surah": 20,
    "ayah": 98,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 99,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 100,
    "text": "(وزر) أي إثم. وقوله عز وجل <span class=\"book-ayah text-primary\">﴿فَإِنَّهُ يَحْمِلُ يَوْمَ الْقِيَامَةِ وِزْرًا﴾</span> أي حملا ثقيلا من الإثم."
  },
  {
    "surah": 20,
    "ayah": 101,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 102,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 103,
    "text": "<span class=\"book-ayah text-primary\">﴿يَتَخَافَتُونَ﴾</span> أي يتسارون."
  },
  {
    "surah": 20,
    "ayah": 104,
    "text": "<span class=\"book-ayah text-primary\">﴿أَمْثَلُهُمْ طَرِيقَةً﴾</span> أعدلهم قولا عند نفسه."
  },
  {
    "surah": 20,
    "ayah": 105,
    "text": "<span class=\"book-ayah text-primary\">﴿يَنسِفُهَا رَبِّي نَسْفاً﴾</span>: يقلعها من أصلها. ويقال: ينسفها يذريها ويطيرها."
  },
  {
    "surah": 20,
    "ayah": 106,
    "text": "<span class=\"book-ayah text-primary\">﴿قَاعاً صَفْصَفاً﴾</span>: مستوى من الأرض أملس."
  },
  {
    "surah": 20,
    "ayah": 107,
    "text": "<span class=\"book-ayah text-primary\">﴿أَمْتاً﴾</span> ارتفاعا وهبوطا. ويقال: نبكا. النبك الروابي من الطين."
  },
  {
    "surah": 20,
    "ayah": 108,
    "text": "<span class=\"book-ayah text-primary\">﴿وَخَشَعَتِ ٱلأَصْوَاتُ لِلرَّحْمَـٰنِ﴾</span> أي خفتت. وقوله عز وجل:<span class=\"book-ayah text-primary\">﴿ تَرَى ٱلأَرْضَ خَاشِعَةً ﴾</span><span class=\"surah-ref\">[فصلت: ٣٩]</span> أي ساكنة مطمئنة <span class=\"book-ayah text-primary\">﴿هَمْساً﴾</span> أي صوتا خفيا، وقيل: يعني صوت الأقدام إلى المحشر."
  },
  {
    "surah": 20,
    "ayah": 109,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 110,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 111,
    "text": "<span class=\"book-ayah text-primary\">﴿عَنَتِ ٱلْوُجُوهُ لِلْحَيِّ ٱلْقَيُّومِ﴾</span> أي استأسرت وذلت وخضعت."
  },
  {
    "surah": 20,
    "ayah": 112,
    "text": "<span class=\"book-ayah text-primary\">﴿هَضْماً﴾</span>: نقصا، يقول: <span class=\"book-ayah text-primary\">﴿فَلاَ يَخَافُ ظُلْماً وَلاَ هَضْماً﴾</span> أي لا يظلم بأن يحمل ذنب غيره، ولا هضما: أي ولا يهضم فينقص من حسناته. يقال هضمه واهتضمه إذا نقصه حقه."
  },
  {
    "surah": 20,
    "ayah": 113,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 114,
    "text": ""
  },
  {
