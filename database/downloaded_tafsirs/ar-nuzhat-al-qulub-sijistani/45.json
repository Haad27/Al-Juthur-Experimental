  {
    "surah": 45,
    "ayah": 23,
    "text": "<span class=\"book-ayah text-primary\">﴿أَفَرَأَيْتَ مَنِ ٱتَّخَذَ إِلَـٰهَهُ هَوَاهُ﴾</span> أي ما تميل إليه نفسه. انظر ٨٧ من البقرة."
  },
  {
    "surah": 45,
    "ayah": 24,
    "text": "<span class=\"book-ayah text-primary\">﴿ٱلدَّهْرُ﴾</span> مرور السنين والأيام."
  },
