  {
    "surah": 54,
    "ayah": 4,
    "text": "<span class=\"book-ayah text-primary\">﴿مُزْدَجَرٌ﴾</span> أي متعظ ومنته، وهو مفتعل من زجرت."
  },
  {
    "surah": 54,
    "ayah": 5,
