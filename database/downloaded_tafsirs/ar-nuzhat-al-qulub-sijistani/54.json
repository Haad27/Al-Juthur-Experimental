  {
    "surah": 54,
    "ayah": 8,
    "text": "<span class=\"book-ayah text-primary\">﴿مُهْطِعِينَ إِلَى الدَّاعِ﴾</span> أي ناظرين قد رفعوا رءوسهم إلى الداعي. وانظر ٤٣ من إبراهيم."
  },
  {
    "surah": 54,
    "ayah": 9,
    "text": "<span class=\"book-ayah text-primary\">﴿ٱزْدُجِرَ﴾</span>: افتعل، من الزجر وهو الانتهار."
  },
  {
    "surah": 54,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 11,
    "text": "<span class=\"book-ayah text-primary\">﴿مُّنْهَمِرٍ﴾</span> أي كثير سريع الإنصباب، ومنه همر الرجل إذا أكثر الكلام وأسرع."
  },
  {
    "surah": 54,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 13,
    "text": "<span class=\"book-ayah text-primary\">﴿دُسُرٍ﴾</span>: مسامير، واحدها دسار، والدسار: الشرط التي تسد بها السفينة."
  },
  {
    "surah": 54,
    "ayah": 14,
    "text": ""
