  {
    "surah": 40,
    "ayah": 4,
    "text": "<span class=\"book-ayah text-primary\">﴿تَقَلُّبُهُمْ فِي الْبِلَادِ﴾</span>: أي تصرفهم فيها للتجارة، أي فلا يغررك تصرفهم وأمنهم وخروجهم من بلد إلى بلد، وإن الله تعالى محيط بهم."
  },
  {
    "surah": 40,
    "ayah": 5,
    "text": "<span class=\"book-ayah text-primary\">﴿لِيُدْحِضُوا بِهِ الْحَقَّ﴾</span> أي ليزيلوا به الحق ويذهبوا به. انظر ١٦ من الشورى."
  },
  {
    "surah": 40,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿حَقَّتْ كَلِمَةُ رَبِّكَ﴾</span> أي وجبت."
  },
  {
    "surah": 40,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 40,
    "ayah": 8,
    "text": ""
  },
