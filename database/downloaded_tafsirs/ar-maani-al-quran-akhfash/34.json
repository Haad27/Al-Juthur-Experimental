  },
  {
    "surah": 34,
    "ayah": 15,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿بَلْدَةٌ طَيِّبَةٌ﴾</span> ( ١٥ ) أي على : هذهِ بَلْدَةٌ طَيِّبَةٌ."
  },
  {
    "surah": 34,
    "ayah": 16,
    "text": ""
  },
