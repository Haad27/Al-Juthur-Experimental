    "surah": 30,
    "ayah": 30,
    "text": "وقال [ ١٥٩ ء ] <span class=\"book-ayah text-primary\">﴿فِطْرَتَ اللَّهِ﴾</span> ( ٣٠ ) فنصبها على الفعل كأنه قال \" فَطَرَ اللهُ تِلْكَ فِطْرَةً \"."
  },
  {
    "surah": 30,
    "ayah": 31,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿مُنِيبِينَ﴾</span> ( ٣١ ) على الحال لأنه حين قال <span class=\"book-ayah text-primary\">﴿فَأَقِمْ وَجْهَكَ﴾</span> ( ٣٠ ) قد أمره وأمر قومه حتى كأنه قال \" فَأَقِيمُوا وَجُوهَكُمْ مُنِيبينَ \"."
  },
  {
    "surah": 30,
    "ayah": 32,
    "text": ""
  },
  {
    "surah": 30,
    "ayah": 33,
    "text": ""
  },
  {
    "surah": 30,
    "ayah": 34,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿لِيَكْفُرُواْ بِمَآ آتَيْنَاهُمْ فَتَمَتَّعُواْ﴾</span> ( ٣٤ ) فمعناه - و الله أعلم - فعلوا ذلك ليَكْفُرُوا. وإنما أقبل عليهم فقال \" تَمَتَّعُوا \" <span class=\"book-ayah text-primary\">﴿فَسَوْفَ تَعْلَمُونَ﴾</span> وقال بعضهم <span class=\"book-ayah text-primary\">﴿فَتَمَتَّعُوا فسوف يَعْلَمونَ﴾</span> كأنه \" فَقَدْ تَمَتَّعُوا فَسَوْفَ يَعْلَمُونَ \"."
  },
  {
    "surah": 30,
    "ayah": 35,
    "text": ""
  },
  {
    "surah": 30,
    "ayah": 36,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿وَإِن تُصِبْهُمْ سَيِّئَةٌ إِذَا هُمْ يَقْنَطُونَ﴾</span> ( ٣٦ ) فقوله <span class=\"book-ayah text-primary\">﴿إِذَا هُمْ يَقْنَطُونَ﴾</span> هو الجواب لأن \" إِذا \" معلقة بالكلام الأول بمنزلة الفاء."
  },
