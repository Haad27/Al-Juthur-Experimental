  {
    "surah": 24,
    "ayah": 31,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿أَوِ الطِّفْلِ الَّذِينَ لَمْ يَظْهَرُواْ﴾</span> ( ٣١ ) جعل <span class=\"book-ayah text-primary\">﴿الطِفْل﴾</span> جماعة كما قال <span class=\"book-ayah text-primary\">﴿وَيُوَلُّونَ الدُّبُرَ﴾</span>."
  },
  {
    "surah": 24,
    "ayah": 32,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿مِنْ عِبَادِكُمْ﴾</span> ( ٣٢ ) يريد \" مِنْ عَبِيدِكُم \" كما تقول : \" هُمْ عِبَادُ اللهِ \" و \" عَبِيدُ اللهِ \"."
  },
  {
    "surah": 24,
    "ayah": 33,
    "text": ""
  },
  {
    "surah": 24,
    "ayah": 34,
    "text": ""
  },
  {
    "surah": 24,
    "ayah": 35,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿كَمِشْكَاةٍ﴾</span> ( ٣٥ ) أيْ : كَمَثَلِ مِشْكَاةٍ. <br />\nوقال <span class=\"book-ayah text-primary\">﴿كَوْكَبٌ دُرِّيٌّ﴾</span> ( ٣٥ ) إذا جعله من \" الدُرّ \" و<span class=\"book-ayah text-primary\">﴿دِرِّيء﴾</span> من \" دَرَأَ \" همزها وجعلها \" فِعِّيل \" وذلك من تلألؤه. وقال بعضهم<span class=\"book-ayah text-primary\">﴿دَرِّيٌ﴾</span> مثل <span class=\"book-ayah text-primary\">﴿فَعِّيل﴾</span>. <br />\nوَأَمَّا <span class=\"book-ayah text-primary\">﴿مَثَلُ نُورِهِ كَمِشْكَاةٍ فِيهَا مِصْبَاحٌ﴾</span> ( ٣٥ ) [ ١٥٤ ب ] فالمصباح في المعنى أَنَ مثلَ ما أنار من الحق في بيانه كمثل المشكاة. ليس لله مثل تبارك وتعالى."
  },
