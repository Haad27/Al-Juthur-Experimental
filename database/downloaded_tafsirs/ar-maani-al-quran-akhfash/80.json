  {
    "surah": 80,
    "ayah": 15,
    "text": "قال <span class=\"book-ayah text-primary\">﴿بِأَيْدِي سَفَرَةٍ﴾</span> ( ١٥ ) وواحدهم \" السافِر \" مثل \" الكافِرِ \" و \" الكَفَرةِ \"."
  },
  {
    "surah": 80,
    "ayah": 16,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿كِرَامٍ [ ١٨٢ ب ] بَرَرَةٍ﴾</span> ( ١٦ ) وواحدهم \" البارّ \" و \" البَرَرةُ \" جماعة \" الأَبْرار \"."
  },
  {
    "surah": 80,
    "ayah": 17,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿قُتِلَ الإِنسَانُ مَا أَكْفَرَهُ﴾</span> ( ١٧ ) معناه على وجهين، قال بعضهم \" على التعجب \"، وقال بعضهم : \" أيُّ شَيْءٍ أَكْفَرَهُ \"."
  },
  {
    "surah": 80,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 80,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 80,
    "ayah": 20,
    "text": "قال <span class=\"book-ayah text-primary\">﴿ثُمَّ السَّبِيلَ يَسَّرَهُ﴾</span> ( ٢٠ ) تقول \" الطريقَ هَدَاهُ \" أي : \" هداهُ الطريقَ \"."
  },
