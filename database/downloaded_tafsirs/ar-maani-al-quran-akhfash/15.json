  {
    "surah": 15,
    "ayah": 56,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِ﴾</span> ( ٥٦ ) لأنها من \" قَنَطَ \"  \" يَقْنِطُ \" وقال بعضهم ( يَقْنُطُ ) مثل \" يَقْتُل \" و \" يقنَطَ \" مثل \" عَلِمَ \" يَعْلَمُ \"."
  },
  {
    "surah": 15,
    "ayah": 57,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 58,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿إِلَى قَوْمٍ مُّجْرِمِينَ ( ٥٨ ) إِلاَّ آلَ لُوطٍ﴾</span> ( ٥٩ ) استثناء من المجرمين أي : لا يدخلون في الإجرام."
  },
  {
    "surah": 15,
    "ayah": 59,
    "text": "<span class='d-block'>نص مكرر لاشتراكه مع الآية ٥٨:</span><span>وقال <span class=\"book-ayah text-primary\">﴿إِلَى قَوْمٍ مُّجْرِمِينَ ( ٥٨ ) إِلاَّ آلَ لُوطٍ﴾</span> ( ٥٩ ) استثناء من المجرمين أي : لا يدخلون في الإجرام. </span><hr>"
  },
