  {
    "surah": 15,
    "ayah": 39,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿رَبِّ بِمَا أَغْوَيْتَنِي﴾</span> ( ٣٩ ) يقول : \" بإِغوائِكَ إِيّايَ \" <span class=\"book-ayah text-primary\">﴿لأُزَيِّنَنَّ لَهُمْ﴾</span> ( ٣٩ ) على القسم كما تقول : \" بِاللهِ لأَفْعَلَنَّ \"."
  },
  {
    "surah": 15,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 41,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿هَذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ﴾</span> ( ٤١ ) يقول : عَلَيَّ دِلاَلَتُه. نحو قول العرب \" عَلَيَّ الطريقُ الليلة \" أي : عليّ دِلاَلَتُه."
  },
  {
    "surah": 15,
    "ayah": 42,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 43,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 44,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿لِكُلِّ بَابٍ مِّنْهُمْ جُزْءٌ مَّقْسُومٌ﴾</span> ( ٤٤ ) لأنَّه من \" جَزَّأْتُهُ \" و( مِنْهُمْ ) يعني : من الناس."
  },
