  {
    "surah": 20,
    "ayah": 69,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿السَّاحِرُ حَيْثُ أَتَى﴾</span> ( ٦٩ ) وفي حرف ابن مسعود <span class=\"book-ayah text-primary\">﴿أيْنَ أَتَى﴾</span> وتقول العرب : \" جِئْتُكَ من أيْنَ لا تَعْلَم \" و \" مِنْ حَيْثُ لا تَعْلَم \"."
  },
  {
    "surah": 20,
    "ayah": 70,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 71,
    "text": ""
  },
  {
    "surah": 20,
    "ayah": 72,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿لَن نُّؤْثِرَكَ عَلَى مَا جَاءَنَا مِنَ الْبَيِّنَاتِ وَالَّذِي فَطَرَنَا﴾</span> ( ٧٢ ) يقول : \" لَنْ نُؤْثِرَكَ على الَّذِي فَطَرَنا \"."
  },
  {
    "surah": 20,
    "ayah": 73,
    "text": ""
  },
