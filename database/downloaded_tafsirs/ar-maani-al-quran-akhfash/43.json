  {
    "surah": 43,
    "ayah": 5,
    "text": "قال <span class=\"book-ayah text-primary\">﴿أَن كُنتُمْ قَوْماً مُّسْرِفِينَ﴾</span> ( ٥ ) يقول : \" لأَِنْ كُنْتُمْ \"."
  },
