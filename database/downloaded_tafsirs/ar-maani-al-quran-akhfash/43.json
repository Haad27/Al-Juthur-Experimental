  {
    "surah": 43,
    "ayah": 26,
    "text": "وقال <span class=\"book-ayah text-primary\">﴿إِنَّنِي بَرَاءٌ مِّمَّا تَعْبُدُونَ﴾</span> ( ٢٦ ) تقول العرب \" أَنَا بَراءٌ منك \"."
  },
  {
    "surah": 43,
    "ayah": 27,
    "text": ""
