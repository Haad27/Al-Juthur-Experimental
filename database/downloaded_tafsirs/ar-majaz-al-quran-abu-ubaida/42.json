    "ayah": 21,
    "text": "<span class=\"book-ayah text-primary\">﴿شَرَعُوا لُهْمِ مِنْ الدِّينِ﴾</span> ابتدعوا."
  },
  {
    "surah": 42,
    "ayah": 22,
    "text": ""
