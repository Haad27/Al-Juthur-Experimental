    "ayah": 1,
    "text": "قوله عزت قدرته :<span class=\"book-ayah text-primary\">﴿ق﴾</span> مجازها مجاز أوائل السور."
  },
  {
    "surah": 50,
    "ayah": 2,
    "text": ""
  },
  {
    "surah": 50,
    "ayah": 3,
    "text": "<span class=\"book-ayah text-primary\">﴿ذَلِكَ رَجْعٌ بَعِيدٌ﴾</span> ردٌ بعيدٌ."
  },
  {
    "surah": 50,
    "ayah": 4,
    "text": ""
  },
  {
    "surah": 50,
    "ayah": 5,
    "text": "<span class=\"book-ayah text-primary\">﴿فَهُمْ فيِ أَمْرٍ مَرِيجٍ﴾</span> مختلط، يقال : قد مرج أمر الناس اختلط وأهمل قال أبو ذؤيب :<br />\nفخَرَّ كأنه حُوطٌ مَرِيجُ<br />\nأي سهم. قال رسول الله صلى الله عليه وسلم : \" كيف بك إذا بقيتَ في حُثالة من الناس مَرِجتْ عهودُهم وأماناتهم \" أي اختلطت."
  },
  {
    "surah": 50,
    "ayah": 6,
    "text": "<span class=\"book-ayah text-primary\">﴿مَا لَهَا مِنْ فُرُوجٍ﴾</span> أي فتوق واحدها فرج وفتق."
  },
  {
    "surah": 50,
    "ayah": 7,
    "text": "<span class=\"book-ayah text-primary\">﴿مِنْ كُلِّ زَوْجٍ بَهِيجٍ﴾</span> أي حسن."
  },
  {
    "surah": 50,
    "ayah": 8,
    "text": "<span class=\"book-ayah text-primary\">﴿تَبْصِرَةً وَذِكْرَى لِكلِّ عَبْدٍ مُنِيبٍ﴾</span> نصبها كنصب المصادر."
  },
  {
    "surah": 50,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 50,
    "ayah": 10,
    "text": "<span class=\"book-ayah text-primary\">﴿وَالنَّخْلَ بَاسِقَاتٍ﴾</span> طوال ويقال : جبل باسق وحسبٌ باسق قال ابن نوفل لابن هبيرة :<table class='poem'><tr><td>يا بنَ الذين بفضلهم</td><td>بَسَقتْ على قَيْسٍ فزارهْ</td></tr></table>\n<span class=\"book-ayah text-primary\">﴿طَلْعٌ نَضِيدٌ﴾</span> منضود."
  },
  {
    "surah": 50,
    "ayah": 11,
    "text": "<span class=\"book-ayah text-primary\">﴿كَذِلِك الْخُروجُ﴾</span> يوم القيامة قال العجاج :<table class='poem'><tr><td>أليس يوم سُمّى الخروجا</td><td>أَعظمَ يوم رَجّةً رَجُوجا</td></tr></table>"
  },
  {
    "surah": 50,
    "ayah": 12,
    "text": "<span class=\"book-ayah text-primary\">﴿وَأَصْحَابُ الرَّسِّ﴾</span> المعدن وكل ركية لم تطو قال الجعدي :<table class='poem'><tr><td>سَبَقتُ إِلى فَرَطٍ ناهلٍ</td><td>تنابلةً يحفِرون الرِّساسا</td></tr></table>"
  },
  {
    "surah": 50,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 50,
    "ayah": 14,
    "text": ""
  },
  {
