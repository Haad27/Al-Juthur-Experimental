    "surah": 54,
    "ayah": 8,
    "text": "<span class=\"book-ayah text-primary\">﴿مُهْطِعِينَ إِلى الدّاعِ﴾</span> مسرعين."
  },
  {
    "surah": 54,
    "ayah": 9,
    "text": "<span class=\"book-ayah text-primary\">﴿وَازْدُجِرَ﴾</span> افتعل من زجر."
  },
  {
    "surah": 54,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 12,
    "text": "<span class=\"book-ayah text-primary\">﴿فَالْتَقى المْاَءُ عَلَى أَمْرٍ قَدْ قُدِر﴾</span> مجازه : الماء الذي خرج من الأرض وما سال من السماء."
  },
  {
    "surah": 54,
    "ayah": 13,
    "text": "<span class=\"book-ayah text-primary\">﴿أَلْوَاحٍ وَدُسُرٍ﴾</span> الدسر المسامير والخزر واحدها دسار، يقال هات لي دساراً."
  },
  {
    "surah": 54,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 15,
    "text": "<span class=\"book-ayah text-primary\">﴿مُدَّكِرٍ﴾</span> مذتكر فلما أدغم التاء في الذال تحولت الذال دالاً."
  },
  {
    "surah": 54,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 19,
    "text": "<span class=\"book-ayah text-primary\">﴿صَرْصَراً﴾</span> شديدة ذات صوت. <br />\n<span class=\"book-ayah text-primary\">﴿مُسْتَمِرٍ﴾</span> شديد قد استمر."
  },
  {
    "surah": 54,
    "ayah": 20,
    "text": "<span class=\"book-ayah text-primary\">﴿أَعْجَازُ نَخْلٍ مُنْقَعرٍ﴾</span> أسافل نخلٍ منقلع من أصله، يقال : هي النخل وهو النخل فمجازها ها هنا : لغة من ذكر وفي آية أخرى } أَعْجَازُ نَخْلٍ خَاوِيَةٍ } في لغة من أنث."
  },
  {
    "surah": 54,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 54,
    "ayah": 24,
    "text": "<span class=\"book-ayah text-primary\">﴿ضَلاَلٍ وَسُعُرٍ﴾</span> جميع سعيرة."
  },
  {
    "surah": 54,
    "ayah": 25,
    "text": "<span class=\"book-ayah text-primary\">﴿أَأُلْقِىَ الذِّكرُ عَلَيْهِ مِنْ بَيْنِنَا﴾</span> أجاءه الذكر كما تقول : ألقيت عليه مسألة وألقيت عليه حسابا."
  },
  {
    "surah": 54,
    "ayah": 26,
    "text": "<span class=\"book-ayah text-primary\">﴿الأشِرُ﴾</span> ذو التجبر والكبرياء وربما كان النشاط."
  },
  {
