  {
    "surah": 45,
    "ayah": 18,
    "text": "<span class=\"book-ayah text-primary\">﴿عَلَى شَرِيعَةٍ﴾</span> على طريقة وسنة."
  },
  {
    "surah": 45,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 20,
    "text": "<span class=\"book-ayah text-primary\">﴿هَذَا بَصَائرُ لِلنَّاسِ﴾</span> مجازها : هذا القرآن بصائر للناس."
  },
  {
    "surah": 45,
    "ayah": 21,
    "text": "<span class=\"book-ayah text-primary\">﴿أَمْ حَسبَ الّذينَ اجْتَرَحُوا السَّيئاتِ﴾</span> اكتسبوا <span class=\"book-ayah text-primary\">﴿أَنْ نَجْعَلَهُمْ كَالّذِينَ آمَنُوا وَعَملوا الصَّالحاتِ﴾</span> تم الكلام ثم استأنف فقال<span class=\"book-ayah text-primary\">﴿سَوَاءٌ مَحْيَاهُمْ وَمَمَاتُهْمْ﴾</span> أي سواء حياة الكافر ومماته هو كافر حياته ومماته، والمؤمن مؤمن حياته ومماته."
  },
  {
    "surah": 45,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 26,
    "text": "<span class=\"book-ayah text-primary\">﴿يَوْمَ الْقِيَامَةَ لا رَيْبَ فِيهِ﴾</span> عاد إلى اليوم أي لا شك فيه في اليوم."
  },
  {
    "surah": 45,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 45,
    "ayah": 28,
    "text": "<span class=\"book-ayah text-primary\">﴿وَتَرَى كُلَّ أُمَّةٍ جاثِيةً﴾</span> على الركب، قال الكميت :<table class='poem'><tr><td>هُم تركوا سَرَاتَكُمُ جُثيِاًّ</td><td>ومَنْ بَعد السراة مُغْرَبَلينا</td></tr></table>"
  },
  {
    "surah": 45,
    "ayah": 29,
    "text": "<span class=\"book-ayah text-primary\">﴿إنَّا كُنَّا نَسْتَنْسِخُ مَا كُنْتمٌ تَعْمَلُونَ﴾</span> أي نثبت."
  },
