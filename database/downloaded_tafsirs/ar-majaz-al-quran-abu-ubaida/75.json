  {
    "surah": 75,
    "ayah": 7,
    "text": "<span class=\"book-ayah text-primary\">﴿فإذَا بَرِقَ البَصَرُ﴾</span> إذا شق البصر وقال الكلابي :<table class='poem'><tr><td>لمَّا أَتانِي ابن صُبَيْحٍ راغباً</td><td>أعطيته عِيساً صِهاباً فَبَرقْ</td></tr></table>"
  },
  {
    "surah": 75,
    "ayah": 8,
    "text": "<span class=\"book-ayah text-primary\">﴿وَخَسَفَ الْقَمَرُ﴾</span> وكسف القمر واحد، ذهب ضوءه."
  },
  {
    "surah": 75,
    "ayah": 9,
    "text": "<span class=\"book-ayah text-primary\">﴿وَجُمِعَ الشَّمْسُ وَالْقَمَرُ﴾</span> لتذكير القمر. <br />\n<span class=\"book-ayah text-primary\">﴿لاَ وَزَرَ﴾</span> لا جبل، قال ابن الذئبة. <table class='poem'><tr><td>لَعَمَرُك ما للِفتى مِن وَزَرْ</td><td>من الموت يُنجيُه والكِبَرْ</td></tr></table>"
