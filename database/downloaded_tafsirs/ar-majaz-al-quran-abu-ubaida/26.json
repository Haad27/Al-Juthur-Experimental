  {
    "surah": 26,
    "ayah": 54,
    "text": "<span class=\"book-ayah text-primary\">﴿إنَّ هؤُلاَءِ لَشِرْذِمَةٌ قلِيلونُ﴾</span> أي طائفة وكل بقية قليلة فهي شرذمة قال :<br />\nيحذين في شراذم النِّعالِ ***<br />\nأي قطع النعال وبقاياها، وهي ها هنا في موضع الجماعات ألا ترى أنه قال شرذمة قليلون."
  },
  {
    "surah": 26,
    "ayah": 55,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 56,
    "text": "<span class=\"book-ayah text-primary\">﴿وإنَّا لَجَميع حَذِروُنَ﴾</span> قال ابن أحمر :<table class='poem'><tr><td>هل أَنسأْن يوماً إلى غيره</td><td>أَنّى حَوالي وأنّى حَذِرْ</td></tr></table>\nحذر وحذر وحاذر، قوم حذرون وحاذرون، حوالي ذو حيلة، قال عباس بن مرداس :<table class='poem'><tr><td>وإِني حاذر أَنْمِى سلاحي</td><td>إلى أوصال ذَيّالٍ منيعِ</td></tr></table>\nالذيال الفرس الطويل الذنب."
  },
  {
    "surah": 26,
    "ayah": 57,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 58,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 59,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 60,
    "text": "<span class=\"book-ayah text-primary\">﴿فأتَبْعَوُهُمْ مُشرقِين﴾</span> مجاز المشرق مجاز الصبح."
  },
  {
    "surah": 26,
    "ayah": 61,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 62,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 63,
    "text": "<span class=\"book-ayah text-primary\">﴿كالْطَّوِد الْعَظِيم﴾</span> أي كالجبل قال الشاعر :<table class='poem'><tr><td>حَلُّوا بأنْقِرة بَجيش عليهم</td><td>ماء الفُرات يجيء من أَطْوادِ</td></tr></table>"
  },
  {
    "surah": 26,
    "ayah": 64,
    "text": "<span class=\"book-ayah text-primary\">﴿وَأَزْلَفْنَا ثمَّ الآخَرِينَ﴾</span> أي وجمعنا، ومنه ليلة المزدلفة، والحجة فيها أنها ليلة جمع وقال بعضهم وأهلكنا."
  },
