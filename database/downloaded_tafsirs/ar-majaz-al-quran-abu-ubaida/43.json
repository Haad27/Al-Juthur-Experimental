  {
    "surah": 43,
    "ayah": 11,
    "text": "<span class=\"book-ayah text-primary\">﴿فَأَنْشَرَنا بِه بَلْدَةً مَّيْتاً﴾</span> أي أحيينا ونشرت الأرض أي حييت قال الأعشى :<table class='poem'><tr><td>حتى يقول الناس مما رأوا</td><td>يا عجباً للميِّشت الناشر</td></tr></table>"
  },
  {
    "surah": 43,
    "ayah": 12,
    "text": "<span class=\"book-ayah text-primary\">﴿وَهُوَ الّذِي خَلَقَ الأزْوَاجَ كُلّهَا وَجَعَلَ لَكُمْ مِّنْ الْفُلْكِ وَالأنْعَامِ مَا تَرْكَبُونَ لِتَسْتَوُا عَلَى ظُهُوِرِه﴾</span> التذكير ل <span class=\"book-ayah text-primary\">﴿ما﴾</span>."
  },
  {
    "surah": 43,
    "ayah": 13,
    "text": "<span class=\"book-ayah text-primary\">﴿وَمَا كُنّا لَهُ مُقْرِنِينَ﴾</span> ضابطين، يقال : فلان مقرن لفلان أي ضابط له مطيق، قال الكميت :<table class='poem'><tr><td>ركبتم صْعبتي أَشَرّاً وحَيْناً</td><td>ولستم للصِّعاب بمُقْرنِينا</td></tr></table>"
  },
  {
    "surah": 43,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 15,
    "text": "<span class=\"book-ayah text-primary\">﴿مِنْ عِبادِهِ جُزْءاً﴾</span> أي نصيباً."
  },
  {
    "surah": 43,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 18,
    "text": "<span class=\"book-ayah text-primary\">﴿أَوْ مَنْ ينشأ فِي الْحِلْيَةِ﴾</span> يعني الحلى وهذه الجواري."
  },
  {
    "surah": 43,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 23,
    "text": "<span class=\"book-ayah text-primary\">﴿عَلَى أُمَّةٍ﴾</span> على ملة واستقامة."
  },
  {
    "surah": 43,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 26,
    "text": "<span class=\"book-ayah text-primary\">﴿وَإْذ قَال إِبْرَاهِيمُ﴾</span> معناها وقال إبراهيم. <br />\n<span class=\"book-ayah text-primary\">﴿إنّنِي بَرَاءٌ﴾</span> مجازها بلغة علوية يجعلون الواحد والاثنين والثلاثة من الذكر والأنثى على لفظ واحد وأهل نجد يقولون : أنا بريء وهي بريئة ونحن براء للجميع."
  },
  {
    "surah": 43,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 29,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 31,
    "text": "<span class=\"book-ayah text-primary\">﴿وَقَالُوا لَوْلاَ نُزِّلَ هَذَا الْقُرْآنُ﴾</span> معناها هلا."
  },
  {
    "surah": 43,
    "ayah": 32,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 33,
    "text": "<span class=\"book-ayah text-primary\">﴿سُقُفاً مِنْ فِضَّةٍ﴾</span> واحدها سقفٌ مجازها مجاز رهنٍ ورهنٍ قال قعنب بن أم صاحب :<table class='poem'><tr><td>بانت سُعاد وأَمسَى دونها عَدَنُ</td><td>وغَلِقتْ عندها من قبلك الرُّهُنُ</td></tr></table>\nومن قال سقفاً فهو جمع السقفة. <br />\n<span class=\"book-ayah text-primary\">﴿وَمَعَارِجَ﴾</span> المعارج الدرج قال جندل بن المثنى :<br />\nيا رَبِّ رَبَّ البيت ذِي المَعارِجِ ***"
  },
  {
    "surah": 43,
    "ayah": 34,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 35,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 36,
    "text": "<span class=\"book-ayah text-primary\">﴿وَمَنْ يَعْشُ عَنْ ذِكْرِ الرَّحْمنِ نُقَيِّضْ لهُ شَيْطاناً﴾</span> تظلم عينه عنه كأن عليها غشاوة، يقول : من يمل عنه عاشياً إلى غيره، وهو أن يركبه على غير تبين قال الحطيئة :<table class='poem'><tr><td>متى تِأتِهِ تعشو إلى ضَوءِ نارِه</td><td>تجدْ خيرَ نارٍ عندها خيرُ مُوقِدِ</td></tr></table>"
  },
  {
    "surah": 43,
    "ayah": 37,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 38,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 39,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 41,
    "text": "<span class=\"book-ayah text-primary\">﴿فَإِمَّا نَذْهَبَنَّ بِكَ﴾</span> محازها فإن نذهبن بك."
  },
