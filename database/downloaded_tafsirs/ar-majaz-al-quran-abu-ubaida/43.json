  },
  {
    "surah": 43,
    "ayah": 52,
    "text": "<span class=\"book-ayah text-primary\">﴿أَمْ أَنَا خَيْرُ مِّنْ هَذَا الّذِي هُوْ مَهِينٌ﴾</span> مجازها بل أنا خير من هذا."
  },
  {
    "surah": 43,
    "ayah": 53,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 54,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 55,
    "text": "<span class=\"book-ayah text-primary\">﴿فَلَمَّا آسَفُوناَ﴾</span> أغضبونا ويقال : قد أسفت غضبت."
  },
  {
    "surah": 43,
    "ayah": 56,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 57,
    "text": "<span class=\"book-ayah text-primary\">﴿إذَا قَوْمُكَ مِنْهُ يَصِدُّونَ﴾</span> من كسر الصاد فمجازها يضجون ومن ضمها فمجازها يعدلون."
  },
  {
    "surah": 43,
    "ayah": 58,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 59,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 60,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 61,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 62,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 63,
    "text": "<span class=\"book-ayah text-primary\">﴿وَلأُبَيِّنَ لَكُمْ بَعْضَ الّذِي تَخْتَلِفُونَ فِيهِ﴾</span> البعض ها هنا الكل قال لبيد بن ربيعة :<table class='poem'><tr><td>ترّاكُ أمكنةٍ إذا لم ارضها</td><td>أو يعتلقْ بعضَ النفوسِ حِمامُها</td></tr></table>\nالموت لا يعتلق بعض النفوس دون بعض."
  },
  {
    "surah": 43,
    "ayah": 64,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 65,
    "text": ""
  },
