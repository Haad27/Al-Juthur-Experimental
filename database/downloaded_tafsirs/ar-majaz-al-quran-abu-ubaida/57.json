  {
    "surah": 57,
    "ayah": 27,
    "text": "<span class=\"book-ayah text-primary\">﴿ثُمَّ قَفَّيْنَا عَلَى آثَارِهِم﴾</span> أتبعناه. <br />\n<span class=\"book-ayah text-primary\">﴿مَا كَتَبْنَاهَا عَلَيْهِمْ﴾</span> ما كل فناهموها."
  },
  {
    "surah": 57,
    "ayah": 28,
    "text": "<span class=\"book-ayah text-primary\">﴿يُؤْتِكُمْ كِفلَيْنِ مِنْ رَحْمِتَه﴾</span> أي مثلين."
  },
  {
    "surah": 57,
    "ayah": 29,
    "text": "<span class=\"book-ayah text-primary\">﴿لِئَلّا يَعْلَم أَهْلُ الِكْتَابِ﴾</span> مجازها ليعلم أهل الكتاب."
