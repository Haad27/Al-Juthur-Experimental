  {
    "surah": 16,
    "ayah": 10,
    "text": "٤٨٥: ٢: ١٠- سفين <span class=\"book-ayah text-primary\">﴿وَمِنْهُ شَجَرٌ فِيهِ تُسِيمُونَ﴾</span> قال، المراعي. [الآية ١٠].<br>"
  },
  {
    "surah": 16,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 12,
    "text": "٤٨٦: ٣: ١١- سفين قال، كان أصحاب عبد الله يقرءونها <span class=\"book-ayah text-primary\">﴿وَسَخَّرَ لَكُمُ ٱلَّيلَ وَٱلْنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلْنُّجُومُ﴾</span> ويقرءونها <span class=\"book-ayah text-primary\">﴿الرياح مسخرات بأمره﴾</span>.<br> [الآية ١٢].<br>"
  },
  {
    "surah": 16,
    "ayah": 13,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 16,
    "ayah": 15,
    "text": "٤٨٧: ٤: ١٢- سفين <span class=\"book-ayah text-primary\">﴿وَأَلْقَىٰ فِي الْأَرْضِ رَوَاسِيَ﴾</span> الجبال. <span class=\"book-ayah text-primary\">﴿أَن تَمِيدَ بِكُمْ﴾</span> قال، إن تضلْ بكم. [الآية ١٥].<br>٤٨٨: ٥: ١٣- سفين <span class=\"book-ayah text-primary\">﴿وَسُبُلاً لَّعَلَّكُمْ تَهْتَدُونَ﴾</span> قال، الطرق <span class=\"book-ayah text-primary\">﴿وَلَهُ الدِّينُ وَاصِبًا﴾</span> قال، دائماً. [الآية ١٥-٥٢].<br>"
  },
  {
    "surah": 16,
    "ayah": 16,
    "text": "٤٨٩: ٦: ٨- سفين عن منصور عن إبراهيم <span class=\"book-ayah text-primary\">﴿وَعَلامَاتٍ﴾</span> قال، هي الأعلام التي في السمآء <span class=\"book-ayah text-primary\">﴿وَبِالنَّجْمِ هُمْ يَهْتَدُونَ﴾</span> قال، يهتدون في البحر في أسفارهم. [الآية ١٦].<br>"
  },
