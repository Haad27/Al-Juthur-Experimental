  {
    "surah": 7,
    "ayah": 17,
    "text": "٢٨٠: ٢: ١- حدثنا أبو حذيفة ثنا سفين عن منصور عن إبراهيم <span class=\"book-ayah text-primary\">﴿ثُمَّ لآتِيَنَّهُمْ مِّن بَيْنِ أَيْدِيهِمْ﴾</span> قال، من قبل دنياهم <span class=\"book-ayah text-primary\">﴿وَمِنْ خَلْفِهِمْ﴾</span> قال، من قبل آخرتهم <span class=\"book-ayah text-primary\">﴿وَعَنْ أَيْمَانِهِمْ﴾</span> من قبل حسناتهم <span class=\"book-ayah text-primary\">﴿وَعَن شَمَآئِلِهِمْ﴾</span> من قبل سيئاتهم. [الآية ١٧].<br>"
  },
  {
    "surah": 7,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 22,
    "text": "٢٨١: ٣: ٩- سفين عن بن عباس <span class=\"book-ayah text-primary\">﴿وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِنْ وَرَقِ الْجَنَّةِ﴾</span> قال، التين. [الآية ٢٢].<br>"
  },
  {
    "surah": 7,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 24,
    "text": "٢٨٢: ٤: ١٠- سفين عن ليث عن مجاهد في قوله <span class=\"book-ayah text-primary\">﴿اهْبِطُوا بَعْضُكُمْ لِبَعْضٍ عَدُوٌّ﴾</span> قال، آدم والحية والشيطان. [الآية ٢٤].<br>"
  },
  {
    "surah": 7,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 26,
    "text": "٢٨٣: ٥: ١١- سفين في قول الله <span class=\"book-ayah text-primary\">﴿لِبَاساً يُوَارِي سَوْءَاتِكُمْ وَرِيشاً وَلِبَاسُ ٱلتَّقْوَىٰ﴾</span> قال، الريش المال، والرياش الثياب. [الآية ٢٦].<br>"
  },
  {
    "surah": 7,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 7,
    "ayah": 29,
    "text": "٢٨٤: ٦: ٥- سفين عن وقآء بن أياس عن مجاهد <span class=\"book-ayah text-primary\">﴿كَمَا بَدَأَكُمْ تَعُودُونَ﴾</span> قال، يبعث المؤمن مؤمنا والكافر كافرا. [الآية ٢٩].<br>٢٨٥: ٧: ٦- سفين عن الأعمش عن أبي سفين عن جابر بن عبد الله قال، قال رسول الله، صلى الله عليه وسلم،\" يبعث كل عبد على ما مات عليه \"المؤمن على إيمانه والكافر على كفره."
  },
