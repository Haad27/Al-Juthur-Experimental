  {
    "surah": 15,
    "ayah": 19,
    "text": "٤٦٩: ١: ٢١- سفين عن خصيف عن عكرمة قال <span class=\"book-ayah text-primary\">﴿كُلِّ شَيْءٍ مَّوْزُونٍ﴾</span> قال، بقدر [الآية ١٩].<br>"
  },
  {
    "surah": 15,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 22,
    "text": "٤٧٠: ٢: ٥- سفين عن الأعمش عن إبراهيم في قوله <span class=\"book-ayah text-primary\">﴿وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ﴾</span> قال، تلقح السحاب، تجمعه. [الآية ٢٢].<br>٤٧١: ٣: ١٩- سفين <span class=\"book-ayah text-primary\">﴿وَمَآ أَنْتُمْ لَهُ بِخَازِنِينَ﴾</span> بمانعين. [الآية ٢٢].<br>"
  },
  {
    "surah": 15,
    "ayah": 23,
    "text": ""
  },
  {
    "surah": 15,
    "ayah": 24,
    "text": "٤٧٢: ٤: ٣- سفين عن عبد الملك بن أبي سليمان عن مجاهد في قوله <span class=\"book-ayah text-primary\">﴿وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمِينَ مِنْكُمْ﴾</span> قال، الأمم <span class=\"book-ayah text-primary\">﴿وَلَقَدْ عَلِمْنَا الْمُسْتَأْخِرِينَ﴾</span> قال، أمة محمد صلى الله عليه وسلم. [الآية ٢٤].<br>٤٧٣: ٥: ٤- سفين عن سعيد عن عكرمة في قوله <span class=\"book-ayah text-primary\">﴿وَلَقَدْ عَلِمْنَا ٱلْمُسْتَقْدِمِينَ مِنكُمْ﴾</span> قال، من خرج من الخلق <span class=\"book-ayah text-primary\">﴿وَلَقَدْ عَلِمْنَا ٱلْمُسْتَأْخِرِينَ﴾</span> قال، من (في) أصلاب الرجال."
  },
