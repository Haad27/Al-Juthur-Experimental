  },
  {
    "surah": 78,
    "ayah": 9,
    "text": "\" سباتا \" راحة لأبدانكم."
  },
  {
    "surah": 78,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 13,
    "text": "\" وهاجا \" وقادا يعني الشمس."
  },
  {
    "surah": 78,
    "ayah": 14,
    "text": "\" من المعصرات \" السحاب التي قد حان لها أن تمطر فيقال شبهت بمعاصير الجواري والمعصر الجارية التي قد دنت من الحيض، \" ثجاجا \" متدفقا ويقال ثجاجا سيالا ومنه قول النبي صلى الله عليه وسلم أحب العمل إلى الله عز وجل العج والثج فالعج التلبية والثج إسالة الدماء من الذبح والنحر."
  },
  {
    "surah": 78,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 16,
    "text": "\" ألفافا \" ملتفة من الشجر واحدها لف ولفيف ويجوز أن يكون الواحد لفاء وجمعها لف وجمع الجمع ألفاف."
  },
  {
    "surah": 78,
    "ayah": 17,
    "text": "\" ميقاتا \" مفعالا من الوقت."
  },
  {
    "surah": 78,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 23,
    "text": "\" أحقابا \" جمع حقب والحقب ثمانون سنة وقوله \" لابثين فيها أحقابا \"  أي كلما مضى حقي تبعه حقب أخر أبدا."
  },
  {
    "surah": 78,
    "ayah": 24,
    "text": "\" بردا \" أي نوما بلغة هذيل ويقال في مثل منع البرد البرد أي أصابني من البرد ما منعني من النوم."
  },
  {
    "surah": 78,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 26,
    "text": "\" جزاء وفاقا \" لسوء أعمالهم."
  },
  {
    "surah": 78,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 28,
    "text": "\" كذابا \" أي كذبا."
  },
  {
    "surah": 78,
    "ayah": 29,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 31,
    "text": "\" إن للمتقين مفازا \" أي ظفرا بما يريدون يقال فاز بالأمر إذا ظفر به."
  },
  {
    "surah": 78,
    "ayah": 32,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 33,
    "text": "\" وكواعب \" أي نساء قد كعب ثديهن."
  },
  {
    "surah": 78,
    "ayah": 34,
    "text": "\" دهاقا \" مترعة أي ملأى بلغة هذيل."
  },
  {
    "surah": 78,
    "ayah": 35,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 36,
    "text": "\" عطاء حسابا \" أي كافيا يقال أعطاني ما أحسبني أي ما كفاني ويقال أصل هذا أن تعطيه حتى يقول حسبي."
  },
  {
    "surah": 78,
    "ayah": 37,
    "text": ""
  },
  {
    "surah": 78,
    "ayah": 38,
    "text": "\" يوم يقوم الروح والملائكة صفا \" قال المفسرون الروح ملك عظيم من ملائكة الله عز وجل يقوم وحده فيكون صفا وتقوم الملائكة صفا."
  },
