  },
  {
    "surah": 43,
    "ayah": 3,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 4,
    "text": "\" أم الكتاب \" أصله يعني اللوح المحفوظ."
  },
  {
    "surah": 43,
    "ayah": 5,
    "text": "\" صفحا \" إي إعراضا يقال صفحت عن فلان إذا أعرضت عنه والأصل في ذلك أن توليه صفحة وجهك وصفحة عنقك."
  },
  {
    "surah": 43,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 8,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 13,
    "text": "\" مقرنين \" مطيقين من قولك فلان قرن فلان إذا كان مثله في الشدة."
  },
  {
    "surah": 43,
    "ayah": 14,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 15,
    "text": "\" وجعلوا له من عباده جزءا \" أي نصيبا وقيل إناثا وقيل بنات يقال أجزأت المرأة إذا ولدت أنثى قال الشاعر :<table class='poem'><tr><td>إن أجزأت حرة يوما فلا عجب</td><td>قد تجزىء الحرة المذكار أحيانا</td></tr></table>\nوجاء في التفسير أن مشركي العرب قالوا إن الملائكة بنات الله عز وجل عما يقول المبطلون."
  },
  {
    "surah": 43,
    "ayah": 16,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 17,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 18,
    "text": "\" أو من ينشأ في الحلية \" يربى في الحلي يعني البنات."
  },
  {
    "surah": 43,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 20,
    "text": "\" يخرصون \" يكذبون بلغة هذيل."
  },
  {
    "surah": 43,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 22,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 23,
    "text": "\" مقتدون \" متبعون - زه -"
  },
  {
    "surah": 43,
    "ayah": 24,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 25,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 26,
    "text": "\" براء \" مصدر أي بريء وقيل وصف كهيم وهيام."
  },
  {
    "surah": 43,
    "ayah": 27,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 29,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 30,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 31,
    "text": "\" من القريتين \" يعني مكة والطائف."
  },
  {
    "surah": 43,
    "ayah": 32,
    "text": "\" ليتخذ بعضهم بعضا سخريا \" يستخدم بعضهم والسخري بكسر السين من الهزء وبالضم من السخرة وهو أن يضطهد ويكلف عملا بلا أجر."
  },
  {
    "surah": 43,
    "ayah": 33,
    "text": "\" ومعارج عليها يظهرون \" درجات عليها يعلون واحدها معرج ومعراج."
  },
  {
    "surah": 43,
    "ayah": 34,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 35,
    "text": "\" وزخرفا \" الزخرف الذهب ثم جعلوا كل مزين مزخرفا أي ويجعل لهم ذلك ذهبا."
  },
  {
    "surah": 43,
    "ayah": 36,
    "text": "\" يعش عن ذكر الرحمن \" يظلم بصره عنه كأن عليه غشاوة ويقال عشوت إلى النار أعشو إذا استدللت إليها ببصر ضعيف قال الحطيئة :<table class='poem'><tr><td>متى تأته تعشو إلى ضوء ناره</td><td>تجد خير نار عندها خير موقد )</td></tr></table>\nومن قرأ يعش بفتح الشين أي يعم عنه يقال عشي الرجل يعش فهو أعش إذا لم يبصر بالليل وقيل معنى يعشو عن ذكر الرحمن يعرض عنه - زه -، \" نقيض \" نسبب وقيل نسلط عليه وقيل غير ذلك."
  },
  {
    "surah": 43,
    "ayah": 37,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 38,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 39,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 41,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 42,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 43,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 44,
    "text": "\" لذكر لك ولقومك \" أي شرف."
  },
  {
    "surah": 43,
    "ayah": 45,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 46,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 47,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 48,
    "text": "\" أكبر من أختها \" أي من التي تشبهها أو تؤاخيها."
  },
  {
    "surah": 43,
    "ayah": 49,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 50,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 51,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 52,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 53,
    "text": "\" مقترنين \" اثنين اثنين."
  },
  {
    "surah": 43,
    "ayah": 54,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 55,
    "text": "\" آسفونا \" أغضبونا"
  },
  {
    "surah": 43,
    "ayah": 56,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 57,
    "text": "\" يصدون \" يضجون."
  },
  {
    "surah": 43,
    "ayah": 58,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 59,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 60,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 61,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 62,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 63,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 64,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 65,
    "text": ""
  },
