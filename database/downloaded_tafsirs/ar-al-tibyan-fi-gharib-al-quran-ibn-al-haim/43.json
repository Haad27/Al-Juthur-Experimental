  },
  {
    "surah": 43,
    "ayah": 68,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 69,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 70,
    "text": "\" تحبرون \" تسرون وتكرمون بلغة قيس عيلان وبني حنيفة."
  },
  {
    "surah": 43,
    "ayah": 71,
    "text": "\" وأكواب \" أي أباريق لا عرى لها ولا خراطيم واحدها كوب."
  },
  {
    "surah": 43,
    "ayah": 72,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 73,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 74,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 75,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 76,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 77,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 78,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 79,
    "text": "\" أبرموا أمرا \" أحكموه."
  },
  {
    "surah": 43,
    "ayah": 80,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 81,
    "text": "\" فأنا أول العابدين \" إن كنتم تزعمون أن للرحمن ولدا فأنا أول من يعبده على أنه واحد لا ولد له وقيل معناه فأنا أول الأنفين والجاحدين لما قلتم ويقال عبد \" إذا أنف من الشيء."
  },
  {
    "surah": 43,
    "ayah": 82,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 83,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 84,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 85,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 86,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 87,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 88,
    "text": ""
  },
  {
    "surah": 43,
    "ayah": 89,
    "text": "\" فاصفح عنهم \" أعرض عنهم وأصل الصفح أن تنحرف عن الشيء فتوليه صفحة وجهك أي ناحية وجهك وكذلك الإعراض هو أن تولي الشيء عرضك أي جانبك ولا تقبل عليه."
  }
]