  {
    "surah": 36,
    "ayah": 36,
    "text": "<span class=\"book-ayah text-primary\">﴿الأزواج﴾</span> : الأصناف."
  },
  {
    "surah": 36,
    "ayah": 37,
    "text": "قوله تعالى :<span class=\"book-ayah text-primary\">﴿نسلخ منه النهار﴾</span> أي : نخرجه منه إخراجا لا يبقى معه شيء من ضوء النهار، <span class=\"book-ayah text-primary\">﴿مظلمون﴾</span> داخلون في الظلام."
  },
  {
    "surah": 36,
    "ayah": 38,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 39,
    "text": "\" كالعرجون \" أي عود الكباسة."
  },
  {
    "surah": 36,
    "ayah": 40,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 41,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 42,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 43,
    "text": "\" فلا صريخ لهم \" أي مغيث، \" ينقذون \" يخلصون."
  },
  {
    "surah": 36,
    "ayah": 44,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 45,
    "text": ""
  },
  {
    "surah": 36,
    "ayah": 46,
    "text": ""
