    "ayah": 26,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 27,
    "text": "\" القاضية \" المنية يعني الموت."
  },
  {
    "surah": 69,
    "ayah": 28,
    "text": ""
  },
  {
    "surah": 69,
    "ayah": 29,
