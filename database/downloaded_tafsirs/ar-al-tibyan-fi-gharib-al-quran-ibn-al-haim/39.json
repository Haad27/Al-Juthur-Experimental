  },
  {
    "surah": 39,
    "ayah": 45,
    "text": "\" اشمأزت \" نفرت والمشمئز النافر أو مالت بلغة نمير."
  },
  {
    "surah": 39,
    "ayah": 46,
    "text": ""
  },
  {
    "surah": 39,
    "ayah": 47,
    "text": ""
  },
  {
    "surah": 39,
    "ayah": 48,
    "text": "\" وحاق بهم \" أحاط أو جب بلغة قريش واليمن."
  },
  {
    "surah": 39,
    "ayah": 49,
    "text": "خول: أعطى."
