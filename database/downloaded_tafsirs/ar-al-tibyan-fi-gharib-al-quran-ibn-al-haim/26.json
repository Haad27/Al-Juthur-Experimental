    "ayah": 192,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 193,
    "text": "\" الروح الأمين \" جبريل عليه السلام سمى روحا لأن النفوس تحيى به كما تحيى بالأرواح."
  },
  {
    "surah": 26,
    "ayah": 194,
    "text": ""
  },
  {
    "surah": 26,
    "ayah": 195,
    "text": ""
