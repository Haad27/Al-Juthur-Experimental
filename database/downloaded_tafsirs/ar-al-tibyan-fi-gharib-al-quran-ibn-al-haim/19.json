  {
    "surah": 19,
    "ayah": 95,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 96,
    "text": "\" ودا \" محبة في قلوب العباد."
  },
  {
    "surah": 19,
    "ayah": 97,
    "text": "\" قوما لدا \" جمع ألد وهو الشيديد الخصومة."
  },
  {
    "surah": 19,
    "ayah": 98,
    "text": "\" أو تسمع لهم ركزا \" أي صوتا خفيا."
  }
