  },
  {
    "surah": 19,
    "ayah": 4,
    "text": "\" وهن \" ضعف."
  },
  {
    "surah": 19,
    "ayah": 5,
    "text": "\" عاقرا \" عقيما أي لا تلد."
  },
  {
    "surah": 19,
    "ayah": 6,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 7,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 8,
    "text": "\" عتيا \" أي يبسا والعتي والعتي بمعنى وكل مبالغ من كبر أو كفر أو فساد فقد عتا وعتا وعتيا وعتيا وعتوا وعتوا."
  },
  {
    "surah": 19,
    "ayah": 9,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 10,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 11,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 12,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 13,
    "text": "\" وحنانا من لدنا \" رحمة من عندنا."
  },
  {
    "surah": 19,
    "ayah": 14,
    "text": "\" جبارا \" متكبرا."
  },
  {
    "surah": 19,
    "ayah": 15,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 16,
    "text": "\" انتبذت من أهلها \" اعتزلتهم ناحية يقال قعد نبذة ونبذة أي ناحية - زه -."
  },
  {
    "surah": 19,
    "ayah": 17,
    "text": "\" روحنا \" جبريل عليه السلام."
  },
  {
    "surah": 19,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 19,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 20,
    "text": "\" بغيا \" فاجرة."
  },
  {
    "surah": 19,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 19,
    "ayah": 22,
    "text": "\" قصيا \" بعيدا."
  },
  {
    "surah": 19,
    "ayah": 23,
    "text": "\" فأجاءها المخاض \" جاء بها والمخاض تمخض الولد في بطن أمه أي \" تحركه للخروج، \" نسيا \" النسي الشيء الحقير الذي إذا القي نسي ولم يلتفت إليه."
  },
  {
    "surah": 19,
    "ayah": 24,
    "text": "\" سريا \" أي نهرا بلغة توافق السريانية - زه - وهذا قول الجمهور إنه النهر الصغير وقيل الرجل الكريم وهو عيسى عليه السلام."
  },
  {
    "surah": 19,
    "ayah": 25,
    "text": "\" جنيا \" غضا ويقال جنى أي مجني طري."
  },
  {
    "surah": 19,
    "ayah": 26,
    "text": "\" صوما \" أي صمتا والصوم الإمساك عن الطعام والكلام ونحوهما."
  },
  {
    "surah": 19,
    "ayah": 27,
    "text": "\" فريا \" أي عجبا ويقال عظيما."
  },
  {
    "surah": 19,
    "ayah": 28,
    "text": ""
  },
  {
