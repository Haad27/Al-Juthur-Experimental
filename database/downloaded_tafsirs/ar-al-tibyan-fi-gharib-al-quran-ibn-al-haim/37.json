    "ayah": 17,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 18,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 19,
    "text": "\" زجرة \" يعني ننفخة الصور والزجرة الصيحة بشدة وانتهار."
  },
  {
    "surah": 37,
    "ayah": 20,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 21,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 22,
    "text": "\" احشروا الذين ظلموا وأزواجهم \" أي وقرناءهم."
  },
  {
