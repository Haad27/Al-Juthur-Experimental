  {
    "surah": 37,
    "ayah": 106,
    "text": ""
  },
  {
    "surah": 37,
    "ayah": 107,
    "text": "\" بذبح عظيم \" يعني كبش إبراهيم عليه السلام والذبح ما ذبح وبالفتح المصدر."
  },
  {
    "surah": 37,
    "ayah": 108,
