    "ayah": 14,
    "text": ""
  },
  {
    "surah": 14,
    "ayah": 15,
    "text": "\" واستفتحوا \" أي سألوا الفتح وهو القضاء"
  },
  {
    "surah": 14,
    "ayah": 16,
    "text": "\" من ماء صديد \" أي قيح ودم"
  },
  {
    "surah": 14,
    "ayah": 17,
    "text": "\" يسيغه \" يجيزه."
  },
